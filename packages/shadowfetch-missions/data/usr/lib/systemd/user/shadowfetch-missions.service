[Unit]
Description=Shadowfetch Mission Control task queue
After=default.target

[Service]
# No EnvironmentFile. It named ONE provider -- codex.env -- so every
# other provider's credential file was read by nothing, and adding a
# provider meant editing this unit. shadowfetch-missions reads the
# whole directory itself and takes only the identities the provider
# registry declares, so a stray file there cannot inject a name.
Type=simple
ExecStart=/usr/bin/shadowfetch-missions worker
Restart=on-failure
RestartSec=5
UMask=0077
CPUQuota=200%
MemoryHigh=3G
MemoryMax=4G
TasksMax=128
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
