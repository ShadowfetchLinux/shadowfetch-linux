#!/usr/bin/env python3
"""Installed and source-tree entry point for the dedicated mission account."""
import sys
from pathlib import Path
sys.path.insert(0, "/usr/lib/shadowfetch/missions")
for parent in Path(__file__).resolve().parents:
    candidate = parent / "data/usr/lib/shadowfetch/missions"
    if (candidate / "sf_mission_account.py").is_file():
        sys.path.insert(0, str(candidate))
        break
from sf_mission_account import main
raise SystemExit(main())
