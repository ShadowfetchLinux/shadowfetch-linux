#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake --builddirectory=build-debian

override_dh_auto_configure:
	dh_auto_configure --builddirectory=build-debian -- -DENABLE_BEHAVIOR_TESTS=ON

override_dh_auto_test:
	python3 tests/run-tests.py --build-dir build-debian

override_dh_auto_clean:
	rm -rf -- build-debian

override_dh_strip:
	dh_strip --no-automatic-dbgsym
