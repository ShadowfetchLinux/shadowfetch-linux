#!/bin/sh
# phoenix-postboot - finish a phoenix-restore on the next boot.
# Part of Shadowfetch Linux 2.1.2 "Fire Edition".
#
# Two jobs, both cheap and idempotent, run once per boot by
# phoenix-postboot.service:
#
#   1. Hand the volume to phoenix-recover, which finishes or undoes an
#      interrupted restore and then collects leftovers under a bound.
#
#   2. If /var/lib/shadowfetch/phoenix-update-grub exists (written into the
#      restored root by phoenix-restore BEFORE the atomic exchange), run
#      update-grub so the menu's baked paths match the new root, then clear
#      the flag. On failure the flag is kept for the next boot.
#
# 4.0.0 Stage T. This script used to do (2) itself, in two guesses:
#   * `mv @new @_prev_<now>_recovered` - correct when the interrupted restore
#     had passed its atomic exchange (@new IS the previous root) and wrong when
#     it had not (@new is a throwaway copy of a Point that still exists), where
#     it costs a generation of the real previous root at the next collection.
#     Nothing on disk distinguished the two cases; phoenix-restore now writes
#     its update-grub flag into @new BEFORE the exchange, so one does.
#   * `ls -d @_prev_* | sort | tail -1` to pick the survivor - a lexicographic
#     sort, in which @_prev_<TS>_recovered outranks the @_prev_<TS> of the same
#     second, and an unbounded delete loop over anything whose name merely
#     begins with @_prev.
# Neither collected /boot/phoenix-kernel-backup-*, which nothing collected at
# all: one full kernel set per successful restore, forever, on the smallest
# filesystem on the machine.
#
# Skipped entirely inside a "Last Known Good Flame" overlay session: never
# GC the real volume while the user is riding a Point deciding what to keep.

set -u

case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
phoenix-postboot - post-restore boot pass (run by systemd on every boot).

USAGE
  phoenix-postboot     resume an interrupted restore (phoenix-recover),
                       then run update-grub if a restore flagged it

Part of Shadowfetch Linux. https://www.shadowfetchlinux.org/
SFHELP
    exit 0 ;;
  --version)
    echo "phoenix-postboot (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

# Overlay session or live media: do nothing.
[ -f /run/phoenix-overlay ] && exit 0
if [ -e /run/live/medium ] || [ -e /run/live/rootfs ]; then exit 0; fi

[ "$(id -u)" -eq 0 ] || { echo "phoenix-postboot: must run as root" >&2; exit 1; }
[ "$(stat -f -c %T / 2>/dev/null)" = "btrfs" ] || exit 0

FLAG=/var/lib/shadowfetch/phoenix-update-grub
RECOVER=/usr/libexec/phoenix-recover

# --- 1. Resume an interrupted restore, then collect leftovers --------------
#
# This runs BEFORE the flag is consumed below, and the order is load bearing:
# the flag sitting in @ with date=<run> is the durable evidence that the
# atomic exchange completed for that run. Removing it first would make a
# post-exchange crash indistinguishable from a pre-exchange one, which is
# exactly the ambiguity this rewrite exists to remove.
if [ -x "$RECOVER" ]; then
    "$RECOVER" resume || \
        echo "phoenix-postboot: phoenix-recover reported a problem (see above)" >&2
else
    echo "phoenix-postboot: $RECOVER is missing - an interrupted restore was" \
         "NOT finished and leftovers were NOT collected" >&2
fi

# --- 2. update-grub if a restore flagged it --------------------------------
if [ -f "$FLAG" ]; then
    if command -v update-grub >/dev/null 2>&1 && update-grub >/dev/null 2>&1; then
        rm -f "$FLAG"
    else
        echo "phoenix-postboot: update-grub failed; keeping flag for next boot" >&2
    fi
fi

exit 0
