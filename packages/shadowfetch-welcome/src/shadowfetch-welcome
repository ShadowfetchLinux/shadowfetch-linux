        for key in profile_keys:
            preset = PROFILE_BY_KEY.get(key)
            if not preset:
                continue
            agents.update(preset.get("agents", []))
            if preset.get("ai_choice") == "install-buzz":
                want_buzz = True
        for key, checkbox in self.coding_agents.items():
            if key in agents:
                checkbox.setChecked(True)   # plain setChecked keeps select-all in sync
