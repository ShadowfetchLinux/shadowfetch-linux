        fl.addWidget(self.fail_body)
        fl.addLayout(frow)
        self.fail_box.hide()
        lay.addWidget(self.fail_box)
        lay.addStretch(1)

    # -- lifecycle --
    def start(self, catalog_id: str, display_name: str):
        self.catalog_id = catalog_id
        self.display_name = display_name
        self.point = None
        self.nopoint_reason = None
        self.log_path = None
        self.audit_dirty = False
        self.err_text = ""
        self.saw_done = False
        self.fail_box.hide()
        self.bar.setValue(0)
        self.msg.setText("")
        self.lock_note.hide()
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.show()
        self.stage_title.setText(f"Preparing {display_name}...")

        self.runner = InstallRunner(catalog_id)
        self.runner.progressed.connect(self._progress)
        self.runner.eventd.connect(self._event)
        self.runner.finished_rc.connect(self._finished)
        self.runner.start()

    def _progress(self, stage, pct, msg):
        self.bar.setValue(max(0, min(100, int(pct))))
        self.msg.setText(msg)

    def _event(self, name, payload):
        if name == "LOG":
            self.log_path = payload
        elif name == "STAGE":
            if payload == "download":
                self.stage_title.setText(
                    f"Downloading {self.display_name} - safe to cancel")
                self.cancel_btn.setEnabled(True)
                self.bar.setValue(0)
            elif payload == "commit":
                self.stage_title.setText("Finishing - safe to leave running")
                self.cancel_btn.setEnabled(False)
                self.cancel_btn.hide()
                self.bar.setValue(0)
        elif name == "LOCKWAIT":
            self.lock_note.setText(
                "Discover is installing something - Ignition will continue "
                "when it finishes.")
            self.lock_note.show()
        elif name == "LOCKFREE":
            self.lock_note.hide()
        elif name == "POINT":
            try:
                self.point = int(payload)
            except ValueError:
                pass
        elif name == "NOPOINT":
            self.nopoint_reason = payload
        elif name == "AUDIT-DIRTY":
            self.audit_dirty = True
        elif name == "ERROR":
            _, _, msg = payload.partition(" ")
            self.err_text = msg or payload
        elif name == "DONE":
            self.saw_done = True

    def _finished(self, rc):
        if rc == 0 and self.saw_done:
            try:
                if shutil.which("kbuildsycoca6"):
                    subprocess.Popen(["kbuildsycoca6"],
                                     stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
            except Exception:  # noqa: BLE001
                pass
            self.done.emit("success")
            return
        if rc in (126, 127):
            # pkexec: dialog dismissed / not authorized. Nothing happened.
            self.done.emit("auth")
            return
        if rc == 10:
            self.done.emit("cancelled")
            return
        self._show_failure()
        self.done.emit("failed")

    def _show_failure(self):
        self.cancel_btn.hide()
        if self.point is not None:
            self.fail_title.setText(
                f"Your system is protected by Phoenix Point #{self.point}")
            body = (f"The install of {self.display_name} did not complete. "
                    "You can retry, or restore the Point taken just before "
                    "it started - your personal files are untouched either way.")
            self.restore_btn.setText(f"Restore Point #{self.point}")
            self.restore_btn.setVisible(os.path.exists(PHOENIX_RESTORE))
        else:
            if self.nopoint_reason == "not-btrfs":
                self.fail_title.setText(
                    "The install did not complete - no Phoenix Point, "
                    "rollback unavailable")
                body = ("This system does not use the Btrfs filesystem "
                        "(chosen at install), so there is no Point to restore. "
                        "Retry usually completes the job.")
            else:
                self.fail_title.setText("The install did not complete")
                body = "You can retry, or read the log for the exact error."
            self.restore_btn.hide()
        if self.err_text:
            body += "\n\n" + self.err_text
        if self.audit_dirty:
            body += ("\n\nA package was left partly configured; Retry runs "
                     "the repair step first, automatically.")
        self.fail_body.setText(body)
        self.log_btn.setVisible(bool(self.log_path))
        self.fail_box.show()

    # -- buttons --
    def _cancel(self):
        self.cancel_btn.setEnabled(False)
        if self.runner:
            self.runner.cancel()

    def _retry(self):
        self.start(self.catalog_id, self.display_name)

    def _restore(self):
        if self.point is None:
            return
        self.retry_btn.setEnabled(False)
        self.restore_btn.setEnabled(False)
        self.fail_body.setText(
            f"Restoring Phoenix Point #{self.point}... this swaps the "
            "system back atomically and asks for a reboot when done.")
        self._restore_worker = CommandWorker(
            [["pkexec", PHOENIX_RESTORE, str(self.point)]])
        self._restore_worker.finished.connect(self._restored)
        self._restore_worker.start()

    def _restored(self, rc):
        self.retry_btn.setEnabled(True)
        self.restore_btn.setEnabled(True)
        if rc == 0:
            self.fail_body.setText(
                f"Phoenix Point #{self.point} restored. Reboot to finish - "
                "the system will come back exactly as it was before this "
                "install.")
        else:
            self.fail_body.setText(
                "The restore did not complete. Open Control Center - "
                "Recover for the full Phoenix panel, or retry the install.")

    def _view_log(self):
        if not self.log_path:
            return
        for cmd in (["xdg-open", self.log_path], ["kate", self.log_path]):
            if shutil.which(cmd[0]):
                try:
                    subprocess.Popen(cmd)
                    return
                except Exception:  # noqa: BLE001
                    continue


