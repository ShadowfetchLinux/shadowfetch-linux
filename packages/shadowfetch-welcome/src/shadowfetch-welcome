# --help and --version are answered here, before the PyQt6 import and before any
# other work happens.
#
# Two reasons for this position. First, this program is the first-boot wizard,
# and until 2.1.2 its only flag was --force - so `shadowfetch-welcome --version`
# fell straight through to QApplication and opened the setup flow that offers to
# install software. Asking a program what it is must never start an installer.
#
# Second, answering above the import means both flags still work on a machine
# where PyQt6 is missing or broken, which is precisely when someone is most
# likely to be asking which version they are running.
if __name__ == "__main__" and {"-h", "--help", "--version"}.intersection(sys.argv[1:]):
    # The same file every other shadowfetch command reports from, read at run
    # time rather than compiled in, so this can never drift from the system it
    # is running on. "unknown" is honest; a number that might be wrong is not.
    _vfile = Path("/usr/share/shadowfetch/version")
    _ver = _vfile.read_text().strip() if _vfile.is_file() else "unknown"
    if "--version" in sys.argv[1:]:
        print(f"shadowfetch-welcome (Shadowfetch Linux) {_ver}")
    else:
        print(
            "shadowfetch-welcome - first-boot welcome and setup for Shadowfetch Linux\n"
            "\n"
            "Usage: shadowfetch-welcome [OPTION]\n"
            "\n"
            "A graphical wizard that runs on login. Until a bundle choice is made it\n"
            "opens on the Ignition Setup page (Core / Creator / Developer / AI\n"
            "Workstation / Full Flame); afterwards it runs the one-time welcome flow\n"
            "(profile, graphics, desktop, apps, optional Buzz and coding agents)\n"
            "and then\n"
            "exits silently on later logins. Every download remains opt-in.\n"
            "\n"
            "Options:\n"
            "  --force            Run the welcome flow again even though setup has\n"
            "                     already been completed.\n"
            "  --ignition         Open the Ignition bundles page (additive: installed\n"
            "                     bundles show as already on your system).\n"
            "  --catalog SECTION  Open the software catalog on a section: media,\n"
            "                     presets, ai or power.\n"
            "  -h, --help         Show this message and exit.\n"
            "  --version          Show the Shadowfetch Linux version and exit.\n"
            "\n"
            "The setup pages can open Shadowfetch Guide to check this computer without\n"
            "uploading hardware identity. With no options it exits silently if setup\n"
