    def _build_progress(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(48, 44, 48, 36)
        lay.setSpacing(14)
        self.panel = InstallPanel()
        self.panel.done.connect(self._install_done)
        lay.addWidget(self.panel)
        return page

    # -- choose --
    def _pick(self, cid: str):
        self.selected = cid
        for k, card in self.cards.items():
            card.set_selected(k == cid)
        self.continue_btn.setEnabled(True)

    def _hwscan_ready(self, scan: dict):
        ai_card = self.cards.get("ignition-ai")
        if not ai_card:
            return
        sentence = ""
        if isinstance(scan.get("verdict"), dict):
            sentence = scan["verdict"].get("sentence") or ""
        if sentence:
            ai_card.set_verdict(sentence)
        else:
            ai_card.set_verdict(
                "Hardware scan unavailable - the AI Workstation tools install "
                "the same either way.")

    def _update_badge(self, online: bool):
        if online:
            self.badge.setText("● Online")
            self.badge.setStyleSheet(f"color: {GREEN}; background: transparent;")
        else:
            self.badge.setText("● Offline - choices are saved")
            self.badge.setStyleSheet(f"color: {MUTED}; background: transparent;")

    def _decide_later(self):
        # Judge fold - nag rule: the per-user skip flag permanently silences
        # the full-screen page for this user; a passive badge remains in
        # Welcome's normal window and in Control Center.
        try:
            IGNITION_SKIP.parent.mkdir(parents=True, exist_ok=True)
            IGNITION_SKIP.write_text("skipped " + datetime.now().isoformat() + "\n")
        except OSError:
            pass
        self.closed.emit("skipped")

    # -- confirm --
    def _to_confirm(self):
        if not self.selected:
            return
        rec = self.catalog.get(self.selected)
        if not rec:
            return
        self._show_confirm(rec, reoffer=None)

    def _show_confirm(self, rec: dict, reoffer):
        old = self.confirm_page
        self.confirm_page = self._make_confirm(rec, reoffer)
        idx = self.stack.indexOf(old)
        self.stack.removeWidget(old)
        old.deleteLater()
        self.stack.insertWidget(idx, self.confirm_page)
        self.stack.setCurrentWidget(self.confirm_page)

    def _make_confirm(self, rec: dict, reoffer) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(48, 44, 48, 36)
        lay.setSpacing(12)
        name = rec.get("name", rec["id"])
        pkgs = rec.get("packages") or []
        online = self.watcher.is_online()

        if reoffer:
            when = reoffer.get("chosen_at", "")
            try:
                when = datetime.fromisoformat(when).strftime("%d %B %Y")
            except (ValueError, TypeError):
                pass
            lay.addWidget(_label("Welcome back - you're connected.", 22, TEXT, bold=True))
            lay.addWidget(_label(
                f"You chose {name} on {when} - install now? "
                f"{bundle_size_line(rec, self.sizes)}.", 13, MUTED, wrap=True))
        else:
            lay.addWidget(_label(f"Confirm: {name}", 22, TEXT, bold=True))

        card = Card()
        cl = QVBoxLayout(card)
        cl.setContentsMargins(20, 16, 20, 16)
        cl.setSpacing(8)
        cl.addWidget(_label(bundle_size_line(rec, self.sizes), 13, TEXT, bold=True))
        if pkgs:
            installed = dpkg_installed(pkgs)
            line = f"{len(pkgs)} packages"
            if installed:
                line += f" - {len(installed)} already on your system"
            cl.addWidget(_label(line, 11, MUTED))
            if root_is_btrfs():
                cl.addWidget(_label(
                    "Wrapped in a Phoenix Point automatically - roll it back "
                    "any time from Control Center → Recover.", 11, GOLD, wrap=True))
            else:
                # Phoenix's ext4 honesty rule, verbatim intent: never silent.
                cl.addWidget(_label(
                    "No Phoenix Point - rollback unavailable (Phoenix Points "
                    "require the Btrfs filesystem, chosen at install).",
                    11, MUTED, wrap=True))
            cl.addWidget(_label(
                "Downloads first, install second: cancelling the download "
                "changes nothing on disk.", 11, MUTED, wrap=True))
        else:
            cl.addWidget(_label(
                "Nothing to download, nothing to install - Core completes "
                "even offline, with no password prompt.", 11, MUTED, wrap=True))
        lay.addWidget(card)
        lay.addStretch(1)

        btns = QHBoxLayout()
        if reoffer:
            notnow = QPushButton("Not now")
            notnow.setFixedHeight(44)
            notnow.clicked.connect(lambda: self.closed.emit("deferred"))
            change = QPushButton("Change my choice")
            change.setFixedHeight(44)
            change.clicked.connect(
                lambda: self.stack.setCurrentWidget(self.choose_page))
            btns.addWidget(notnow)
            btns.addWidget(change)
        else:
            back = QPushButton("← Back")
            back.setFixedHeight(44)
            back.clicked.connect(
                lambda: self.stack.setCurrentWidget(self.choose_page))
            btns.addWidget(back)
        btns.addStretch(1)

        if not pkgs:
            go = QPushButton("Finish setup - nothing to install")
            go.clicked.connect(lambda: self._mark_done(rec))
        elif online:
            go = QPushButton("Install now")
            go.clicked.connect(lambda: self._install(rec))
        else:
            go = QPushButton("Save my choice")
            go.clicked.connect(lambda: self._save_choice(rec))
        go.setFixedHeight(44)
        btns.addWidget(go)
        lay.addLayout(btns)
        return page

    # -- actions --
    def _install(self, rec: dict):
        self._installing = True
        self._await_reconnect = False
        self.stack.setCurrentWidget(self.progress_page)
        self.panel.start(rec["id"], rec.get("name", rec["id"]))

    def _install_done(self, outcome: str):
        self._installing = False
        rec = self.catalog.get(self.panel.catalog_id, {})
        name = rec.get("name", self.panel.catalog_id)
        if outcome == "success":
            point_line = ""
            if self.panel.point is not None:
                point_line = (f"This install is wrapped in Phoenix Point "
                              f"#{self.panel.point} - roll it back any time "
                              "from Control Center → Recover.")
            self._show_result(
                f"All set - {name} is installed.",
                (point_line + ("\n\n" if point_line else "")
                 + "Your new apps are in the application menu."),
                "completed")
        elif outcome == "cancelled":
            self._show_result(
                "Download cancelled.",
                "Nothing was changed on disk, and partly downloaded packages "
                "resume next time. Your choice is still selected.",
                None, back_to_choose=True)
        elif outcome == "auth":
            self._show_result(
                "Not authorised.",
                "The administrator prompt was closed, so nothing was "
                "installed. You can try again any time.",
                None, back_to_choose=True)
        # "failed" keeps the panel's own Phoenix-led failure screen visible.

    def _save_choice(self, rec: dict):
        self._state_call(["save-choice", rec["id"]],
                         lambda rc: self._saved(rc, rec))

    def _saved(self, rc, rec):
        if rc != 0:
            self._show_result(
                "Could not save the choice.",
                "The choice file was not written. You can pick again, or "
                "install once you are online.", None, back_to_choose=True)
            return
        self._await_reconnect = True
        self._show_result(
            "Saved.",
            f"The moment this machine is connected, Shadowfetch will offer "
            f"to install {rec.get('name', rec['id'])} - in this session or "
            "at any later login. No need to remember.",
            "saved")

    def _mark_done(self, rec: dict):
        self._state_call(["mark-done"], self._core_done)

    def _core_done(self, rc):
        if rc != 0:
            self._show_result(
                "Could not record the choice.",
                "The setup stamp was not written. You can pick again.",
                None, back_to_choose=True)
            return
        self._show_result(
            "Core it is.",
            "Nothing was downloaded and nothing was installed. Firefox ESR, "
            "KeePassXC, Kleopatra, Tor and OnionShare are already on your "
            "system - you are ready.",
            "completed")

    def _state_call(self, args, on_done):
        self._state_worker = CommandWorker([["pkexec", STATE_HELPER] + args])
        self._state_worker.finished.connect(on_done)
        self._state_worker.start()

    # -- result --
    def _show_result(self, title, body, outcome, back_to_choose=False):
        old = self.result_page
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(56, 56, 56, 44)
        lay.setSpacing(14)
        lay.addStretch(1)
        lay.addWidget(_label(title, 24, TEXT, bold=True))
        lay.addWidget(_label(body, 12, MUTED, wrap=True))
        lay.addStretch(2)
        row = QHBoxLayout()
        row.addStretch(1)
        btn = QPushButton("Continue  →")
        btn.setFixedHeight(44)
        if back_to_choose:
            btn.setText("← Back to the choices")
            btn.clicked.connect(lambda: self.stack.setCurrentWidget(self.choose_page))
        else:
            btn.clicked.connect(lambda: self.closed.emit(outcome))
        row.addWidget(btn)
        lay.addLayout(row)

        idx = self.stack.indexOf(old)
        self.stack.removeWidget(old)
        old.deleteLater()
        self.result_page = page
        self.stack.insertWidget(idx, page)
        self.stack.setCurrentWidget(page)

    # -- re-offer (judge fold: NM signal, no re-login) --
    def start_reoffer(self, choice: dict):
        rec = self.catalog.get(choice.get("id"))
        if rec is None:
            # The saved id no longer resolves; fall back to the full page.
            self.stack.setCurrentWidget(self.choose_page)
            return
        self._show_confirm(rec, reoffer=choice)

    def _connectivity_changed(self, online: bool):
        self._update_badge(online)
        if not online or self._installing:
            return
        pending = load_pending()
        if pending and self._await_reconnect:
            # The user saved a choice this very session and the network just
            # arrived: one card, one click - fulfilment, not a nag.
            self._await_reconnect = False
            self.start_reoffer(pending)


