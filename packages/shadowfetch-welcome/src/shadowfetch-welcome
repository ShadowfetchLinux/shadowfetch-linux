# ---- NetworkManager connectivity (the judge-fold re-offer signal) --------
if QT_DBUS:
    class _NMDBusListener(QObject):
        """Receives raw PropertiesChanged messages from the system bus."""
        message = pyqtSignal(object)

        @pyqtSlot(QDBusMessage)
        def handle(self, msg):
            self.message.emit(msg)


class NMWatcher(QObject):
    """Connectivity badge + the reconnect re-offer, without re-login.

    Subscribes to org.freedesktop.NetworkManager PropertiesChanged on the
    system bus; the moment Connectivity reaches 4 (FULL) the changed signal
    fires. When QtDBus is unavailable it degrades to a polite nm-online
    poll - slower, but the re-offer still happens in-session.
    """
    changed = pyqtSignal(bool)

    NM_SERVICE = "org.freedesktop.NetworkManager"
    NM_PATH = "/org/freedesktop/NetworkManager"

    def __init__(self, parent=None):
        super().__init__(parent)
        self._online = None
        self._dbus_ok = False
        if QT_DBUS:
            try:
                self._listener = _NMDBusListener(self)
                self._listener.message.connect(self._on_message)
                bus = QDBusConnection.systemBus()
                self._dbus_ok = bus.connect(
                    self.NM_SERVICE, self.NM_PATH,
                    "org.freedesktop.DBus.Properties", "PropertiesChanged",
                    self._listener.handle,
                )
            except Exception:  # noqa: BLE001
                self._dbus_ok = False
        if not self._dbus_ok:
            self._timer = QTimer(self)
            self._timer.setInterval(25000)
            self._timer.timeout.connect(self._poll)
            self._timer.start()

    def _on_message(self, msg):
        try:
            args = msg.arguments()
            if not args or args[0] != self.NM_SERVICE:
                return
            changed = args[1] if len(args) > 1 else {}
            if isinstance(changed, dict) and "Connectivity" in changed:
                value = changed["Connectivity"]
                if hasattr(value, "variant"):
                    value = value.variant()
                self._set(int(value) == 4)
        except Exception:  # noqa: BLE001
            pass

    def _poll(self):
        self._set(self._probe())

    def _set(self, online: bool):
        if online != self._online:
            self._online = online
            self.changed.emit(online)

    @staticmethod
    def _probe() -> bool:
        try:
            return subprocess.run(["nm-online", "-q", "-t", "0"],
                                  capture_output=True, timeout=5).returncode == 0
        except Exception:  # noqa: BLE001
            return False

    def is_online(self) -> bool:
        if self._dbus_ok:
            try:
                bus = QDBusConnection.systemBus()
                iface = QDBusInterface(self.NM_SERVICE, self.NM_PATH,
                                       "org.freedesktop.DBus.Properties", bus)
                reply = iface.call("Get", self.NM_SERVICE, "Connectivity")
                args = reply.arguments()
                if args:
                    value = args[0]
                    if hasattr(value, "variant"):
                        value = value.variant()
                    online = int(value) == 4
                    self._online = online
                    return online
            except Exception:  # noqa: BLE001
                pass
        online = self._probe()
        self._online = online
        return online


class HwscanWorker(QThread):
    """Fetch the hardware scan without ever blocking the choice screen.

    Reads /var/lib/shadowfetch/hwscan.json when it is from the current
    boot, otherwise execs the CLI with a hard timeout. Emits {} on any
    failure - the AI card then shows its honest 'scan unavailable' line.
    """
    got = pyqtSignal(dict)

    def run(self):
        data = {}
        try:
            if HWSCAN_JSON.is_file():
                with open("/proc/uptime", "r", encoding="utf-8") as fh:
                    boot_time = time.time() - float(fh.read().split()[0])
                if HWSCAN_JSON.stat().st_mtime >= boot_time:
                    data = json.loads(HWSCAN_JSON.read_text(encoding="utf-8"))
        except Exception:  # noqa: BLE001
            data = {}
        if not data and os.path.exists(HWSCAN_CLI):
            try:
                r = subprocess.run([HWSCAN_CLI, "--json"], capture_output=True,
                                   text=True, timeout=3)
                if r.returncode == 0:
                    data = json.loads(r.stdout)
            except Exception:  # noqa: BLE001
                data = {}
        self.got.emit(data if isinstance(data, dict) else {})


# ---- privileged install plumbing ----------------------------------------
class InstallRunner(QThread):
    """Drives pkexec shadowfetch-bundle-install install <id> and streams
    its SF-* machine protocol back to the UI."""
    progressed = pyqtSignal(str, float, str)   # stage, pct, message
    eventd = pyqtSignal(str, str)              # event name, payload
    finished_rc = pyqtSignal(int)

    def __init__(self, catalog_id: str):
        super().__init__()
        self.catalog_id = catalog_id
        self.proc = None

    def run(self):
        try:
            self.proc = subprocess.Popen(
                ["pkexec", BUNDLE_HELPER, "install", self.catalog_id],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, text=True, bufsize=1,
            )
        except Exception as exc:  # noqa: BLE001
            self.eventd.emit("ERROR", f"launch-failed {exc}")
            self.finished_rc.emit(1)
            return
        for line in self.proc.stdout:
            line = line.rstrip("\n")
            if line.startswith("SF-PROGRESS "):
                try:
                    _, stage, pct, msg = line.split(" ", 3)
                    self.progressed.emit(stage, float(pct), msg)
                except ValueError:
                    pass
            elif line.startswith("SF-"):
                name, _, payload = line[3:].partition(" ")
                self.eventd.emit(name, payload)
        rc = self.proc.wait()
        self.finished_rc.emit(rc)

    def cancel(self):
        """Ask the helper to cancel (honoured during stage 1 only)."""
        try:
            if self.proc and self.proc.stdin:
                self.proc.stdin.write("CANCEL\n")
                self.proc.stdin.flush()
        except Exception:  # noqa: BLE001
            pass


class InstallPanel(QWidget):
