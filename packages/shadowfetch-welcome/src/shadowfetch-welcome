class GraphicsPage(QWidget):
    """Show measured renderer state; offer NVIDIA setup only when needed."""
    def __init__(self, on_next):
        super().__init__()
        self._on_next = on_next
        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 44, 48, 36)
        lay.setSpacing(14)
        lay.addWidget(_label("Graphics drivers", 22, TEXT, bold=True))
        gpu = self._detect()
        card = Card()
        cl = QVBoxLayout(card)
        cl.setContentsMargins(20, 18, 20, 18)
        cl.setSpacing(10)
        ready, renderer = self._graphics_ready(gpu)
        label = {
            "nvidia": "NVIDIA",
            "amd": "AMD",
            "intel": "Intel",
            "virtual": "Virtual GPU",
        }.get(gpu, "Graphics")
        if gpu == "virtual":
            if ready:
                cl.addWidget(_label("Virtual GPU acceleration verified", 14, GOLD, bold=True))
                cl.addWidget(_label(
                    f"The VM exposes a hardware Vulkan renderer. {renderer}",
                    12, MUTED, wrap=True))
            else:
                cl.addWidget(_label("Virtual machine uses software rendering", 14, GOLD, bold=True))
                cl.addWidget(_label(
                    f"{renderer} Shadowfetch will not call this hardware acceleration; "
                    "physical GPU performance must be verified on physical hardware.",
                    12, MUTED, wrap=True))
            btn = QPushButton("Open graphics report")
            btn.clicked.connect(lambda: self._launch_gpu(True))
        elif ready:
            cl.addWidget(_label(f"{label} hardware acceleration verified", 14, GOLD, bold=True))
            cl.addWidget(_label(
                f"The DRM render node and hardware Vulkan device both passed. {renderer}",
                12, MUTED, wrap=True))
            btn = QPushButton("Verify again")
            btn.clicked.connect(lambda: self._launch_gpu(True))
        elif gpu == "nvidia":
            cl.addWidget(_label("NVIDIA driver setup recommended", 14, GOLD, bold=True))
            cl.addWidget(_label(
                "Hardware acceleration did not pass verification. Shadowfetch can use NVIDIA's "
                "Debian driver assistant to select the supported branch and kernel module, then "
                "verify the built module before asking you to reboot.",
                12, MUTED, wrap=True))
            btn = QPushButton("Install recommended driver")
            btn.clicked.connect(lambda: self._launch_gpu(False))
        else:
            cl.addWidget(_label(f"{label} acceleration needs verification", 14, GOLD, bold=True))
            cl.addWidget(_label(
                "Mesa is included, but Shadowfetch could not prove a hardware Vulkan renderer. "
                "Open the verification report before relying on GPU acceleration.",
                12, MUTED, wrap=True))
            btn = QPushButton("Verify graphics")
            btn.clicked.connect(lambda: self._launch_gpu(True))
        btn.setFixedHeight(42)
        cl.addWidget(btn, alignment=Qt.AlignmentFlag.AlignLeft)
        lay.addWidget(card)
        lay.addStretch(1)
        nxt = QPushButton("Continue  →")
        nxt.setFixedHeight(44)
        nxt.clicked.connect(self._on_next)
        lay.addWidget(nxt, alignment=Qt.AlignmentFlag.AlignRight)

    def _detect(self):
        try:
            out = subprocess.run(
                ["lspci", "-Dn"], capture_output=True, text=True, timeout=5
            ).stdout
        except Exception:  # noqa: BLE001
            return "unknown"
        return detect_display_vendor(out)

    def _graphics_ready(self, gpu):
        try:
            if not any(Path("/dev/dri").glob("renderD*")):
                return False, "No DRM render node was found."
            if gpu == "nvidia":
                result = subprocess.run(["nvidia-smi", "-L"], capture_output=True,
                                        text=True, timeout=5)
                if result.returncode != 0 or not result.stdout.strip():
                    return False, "The NVIDIA kernel driver is inactive."
            result = subprocess.run(["vulkaninfo", "--summary"], capture_output=True,
                                    text=True, timeout=20)
            summary = result.stdout or ""
            if result.returncode != 0 or not summary.strip():
                return False, "The Vulkan probe failed."
            software_names = ("llvmpipe", "lavapipe", "softpipe",
                              "software rasterizer")
            devices = [line.split("=", 1)[-1].strip()
                       for line in summary.splitlines() if "deviceName" in line]
            hardware_devices = [device for device in devices
                                if not any(name in device.lower()
                                           for name in software_names)]
            if not hardware_devices:
                return False, "Vulkan did not report a hardware rendering device."
            expected = {
                "nvidia": ("nvidia",),
                "amd": ("amd", "radeon", "radv"),
                "intel": ("intel", "anv"),
            }.get(gpu, ())
            if expected and not any(name in summary.lower() for name in expected):
                return False, "The detected GPU is absent from the Vulkan device list."
            return True, ("Renderer: " + ", ".join(hardware_devices[:2]))
        except Exception:  # noqa: BLE001
            return False, "The renderer probe could not complete."

    def _launch_gpu(self, verify=False):
        term = shutil.which("konsole") or shutil.which("x-terminal-emulator")
        if term:
            try:
                command = "shadowfetch-gpu --verify" if verify else "shadowfetch-gpu"
                subprocess.Popen([term, "-e", "bash", "-lc",
                                  f"{command}; echo; read -p 'Press Enter to close...'"])
            except Exception:  # noqa: BLE001
                pass


