def catalog_section_of(rec: dict) -> str:
    sec = rec.get("section")
    if sec in ("media", "presets", "ai", "power"):
        return sec
    kind = rec.get("kind")
    if kind == "template":
        return "ai"
    if kind == "preset":
        return "presets"
    return "media"


