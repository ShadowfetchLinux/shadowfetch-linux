        all_selected = all(checkbox.isChecked() for checkbox in self.coding_agents.values())
        self.select_all_agents.blockSignals(True)
        self.select_all_agents.setChecked(all_selected)
        self.select_all_agents.blockSignals(False)

    def _submit(self):
        coding_agents = {
            key: checkbox.isChecked() for key, checkbox in self.coding_agents.items()
        }
        self._on_next({
            "choice": self.choice,
            "coding_agents": coding_agents,
            "codex": coding_agents["codex"],
        })


class InstallPage(QWidget):
    def __init__(self, on_close):
        super().__init__()
        self.on_close = on_close
        self.local_ai = {"choice": "none", "coding_agents": {}}
        self.install_rc = 0
        self.buzz_state = "not-requested"
        self.coding_agent_states = {
            agent["key"]: "not-requested" for agent in CODING_AGENTS
        }
        self.active_coding_agent = None
        self.busy = False
        self.output_lines = []
        self.failure_details = []

        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 48, 48, 40)
        lay.setSpacing(16)

        self.title = _label("Setting things up…", 22, TEXT, bold=True)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        self.log = _label("", 11, MUTED, wrap=True)

        lay.addWidget(self.title)
        lay.addWidget(self.bar)
        lay.addWidget(self.log)
        lay.addStretch(1)

        buttons = QHBoxLayout()
        self.cancel_btn = QPushButton("Cancel setup")
        self.cancel_btn.setFixedHeight(44)
        self.cancel_btn.hide()
        self.cancel_btn.clicked.connect(self._cancel_setup)
        self.skip_btn = QPushButton("Finish without optional AI tools")
        self.skip_btn.setFixedHeight(44)
        self.skip_btn.hide()
        self.skip_btn.clicked.connect(self._skip_buzz)
        self.done_btn = QPushButton("Finish")
        self.done_btn.setFixedHeight(44)
        self.done_btn.setEnabled(False)
        self.done_btn.clicked.connect(self._finish)
        buttons.addWidget(self.cancel_btn)
        buttons.addWidget(self.skip_btn)
        buttons.addStretch(1)
        buttons.addWidget(self.done_btn)
        lay.addLayout(buttons)

    def start(self, accent_name, accent_hex, flatpak_ids, local_ai):
        self.local_ai = local_ai
        self.busy = True
        self.buzz_state = (
            "pending" if local_ai.get("choice") == "install-buzz" else "not-requested"
        )
        selected_agents = local_ai.get("coding_agents")
        if not isinstance(selected_agents, dict):
            selected_agents = {"codex": bool(local_ai.get("codex"))}
        self.coding_agent_states = {
            agent["key"]: (
                "pending" if selected_agents.get(agent["key"], False) else "not-requested"
            )
            for agent in CODING_AGENTS
        }
        self.active_coding_agent = None
        self.failure_details = []
        self.done_btn.setEnabled(False)
        self.skip_btn.hide()
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.show()
        (CONFIG_DIR / "accent").write_text(f"{accent_name}\n{accent_hex}\n")

        commands = [
            ["kwriteconfig6", "--file", "kdeglobals", "--group", "General",
             "--key", "AccentColor", _rgb(accent_hex)],
        ]
        if flatpak_ids:
            commands.append(["flatpak", "remote-add", "--user", "--if-not-exists",
                             "flathub", FLATHUB_URL])
            for fid in flatpak_ids:
                commands.append(["flatpak", "install", "-y", "--user", "flathub", fid])

        self.worker = CommandWorker(commands)
        self.worker.progress.connect(self.log.setText)
        self.worker.finished.connect(self._on_done)
        self.worker.start()

    def _on_done(self, rc):
        self.install_rc = rc
        self.busy = False
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.hide()
        if rc == 130:
            self.title.setText("Optional app setup was cancelled.")
            self.bar.setRange(0, 1)
            self.bar.setValue(0)
            self.log.setText(
                "The active download was stopped and no later optional apps were started. "
                "Already completed installs were kept."
            )
            self.done_btn.setText("Continue setup")
            self.skip_btn.show()
            self.done_btn.setEnabled(True)
            return
        self._start_next_ai()

    def _start_next_ai(self):
        if self.buzz_state == "pending":
            self._start_buzz_setup()
            return
        for agent in CODING_AGENTS:
            if self.coding_agent_states[agent["key"]] == "pending":
                self._start_coding_agent_setup(agent)
                return
        self._finalize_setup()

    def _start_buzz_setup(self):
        helper = shutil.which("shadowfetch-buzz")
        if not helper:
            self.buzz_state = "failed"
            self.failure_details.append(
                "Buzz: the shadowfetch-buzz helper is missing. Repair shadowfetch-defaults."
            )
            self._start_next_ai()
            return
        self.buzz_state = "installing"
        self.busy = True
        self.output_lines = []
        self.title.setText("Installing Buzz...")
        self.log.setText("Running verified preflight checks...")
        self.bar.setRange(0, 0)
        self.done_btn.setEnabled(False)
        self.skip_btn.hide()
        self.cancel_btn.show()
        self.buzz_worker = StreamingCommandWorker(
            [helper, "setup", "--yes", "--no-open"])
        self.buzz_worker.progress.connect(self._buzz_progress)
        self.buzz_worker.finished.connect(self._buzz_done)
        self.buzz_worker.start()

    def _buzz_progress(self, line):
        if line:
            self.output_lines.append(line)
            self.output_lines = self.output_lines[-5:]
            self.log.setText("\n".join(self.output_lines))

    def _cancel_setup(self):
        for name in ("coding_agent_worker", "buzz_worker", "worker"):
            worker = getattr(self, name, None)
            if worker is not None and worker.isRunning():
                self.cancel_btn.setEnabled(False)
                self.log.setText("Stopping the active setup step safely...")
                worker.cancel()
                return

    def _buzz_done(self, rc):
        self.busy = False
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.hide()
        self.bar.setRange(0, 1)
        self.bar.setValue(1 if rc == 0 else 0)
        if rc == 0:
            self.buzz_state = "ready"
        else:
            self.buzz_state = "failed"
            detail = "\n".join(self.output_lines[-5:]) or f"Setup exited with code {rc}."
            self.failure_details.append(f"Buzz: {detail}")
        if rc == 130:
            self._show_interrupted("Buzz")
            return
        self._start_next_ai()

    def _start_coding_agent_setup(self, agent):
        helper = shutil.which(agent["helper"])
        if not helper:
            self.coding_agent_states[agent["key"]] = "failed"
            self.failure_details.append(
                f"{agent['name']}: the {agent['helper']} helper is missing. "
                "Repair shadowfetch-defaults."
            )
            self._start_next_ai()
            return
        self.active_coding_agent = agent["key"]
        self.coding_agent_states[agent["key"]] = "installing"
        self.busy = True
        self.output_lines = []
        self.title.setText(agent["install_title"])
        self.log.setText(agent["checking"])
        self.bar.setRange(0, 0)
        self.done_btn.setEnabled(False)
        self.skip_btn.hide()
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.show()
        command = [helper]
        if agent["helper_tool"]:
            command.append(agent["helper_tool"])
        command.extend(["setup", "--yes", "--no-open"])
        self.coding_agent_worker = StreamingCommandWorker(command)
        self.coding_agent_worker.progress.connect(self._coding_agent_progress)
        self.coding_agent_worker.finished.connect(self._coding_agent_done)
        self.coding_agent_worker.start()

    def _coding_agent_progress(self, line):
        if line:
            self.output_lines.append(line)
            self.output_lines = self.output_lines[-5:]
            self.log.setText("\n".join(self.output_lines))

    def _coding_agent_done(self, rc):
        key = self.active_coding_agent
        agent = CODING_AGENT_BY_KEY[key]
        self.busy = False
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.hide()
        if rc == 0:
            self.coding_agent_states[key] = "ready"
        else:
            self.coding_agent_states[key] = "failed"
            detail = "\n".join(self.output_lines[-5:]) or f"Setup exited with code {rc}."
            self.failure_details.append(f"{agent['name']}: {detail}")
        self.active_coding_agent = None
        if rc == 130:
            self._show_interrupted(agent["name"])
            return
        self._start_next_ai()

    def _show_interrupted(self, tool):
        self.busy = False
        self.cancel_btn.setEnabled(True)
        self.cancel_btn.hide()
        self.bar.setRange(0, 1)
        self.bar.setValue(0)
        self.title.setText(f"{tool} setup was cancelled.")
        self.log.setText(
            "The active download was stopped safely. Completed installs were kept; "
            "continue to retry or finish without the remaining optional tools."
        )
        self.done_btn.setText("Continue setup")
        self.done_btn.setEnabled(True)
        self.skip_btn.show()

    def _finalize_setup(self):
        ready = []
        if self.buzz_state == "ready":
            ready.append(
                "Buzz Desktop and its private local relay passed every setup check."
            )
        for agent in CODING_AGENTS:
            if self.coding_agent_states[agent["key"]] == "ready":
                ready.append(agent["receipt"])
        if self.install_rc != 0:
            ready.append(
                "One or more optional desktop apps were skipped; retry them later from Discover."
            )

        failed = self.buzz_state == "failed" or any(
            state == "failed" for state in self.coding_agent_states.values()
        )
        self.bar.setRange(0, 1)
        self.bar.setValue(0 if failed else 1)
        self.cancel_btn.hide()
        if failed:
            self.title.setText("Some optional AI tools need attention.")
            self.log.setText("\n".join(ready + self.failure_details))
            self.done_btn.setText("Retry failed tools")
            self.skip_btn.show()
        else:
            names = []
            if self.buzz_state == "ready":
                names.append("Buzz")
            names.extend(
                agent["name"] for agent in CODING_AGENTS
                if self.coding_agent_states[agent["key"]] == "ready"
            )
            if len(names) > 1:
                self.title.setText(f"{len(names)} optional tools are ready.")
                ready.append("Launch any installed tool from the application menu.")
            elif names:
                self.title.setText(f"{names[0]} is ready.")
            else:
                self.title.setText(
                    "All set." if self.install_rc == 0
                    else "Some optional items did not install."
                )
            self.log.setText("\n".join(ready))
            if len(names) == 1:
                self.done_btn.setText(f"Open {names[0]} and finish")
            else:
                self.done_btn.setText("Finish")
            self.skip_btn.hide()
        self.done_btn.setEnabled(True)

    def _finish(self):
        if self.busy:
            return
        retry = False
        if self.buzz_state == "failed":
            self.buzz_state = "pending"
            retry = True
        for key, state in self.coding_agent_states.items():
            if state == "failed":
                self.coding_agent_states[key] = "pending"
                retry = True
        if retry or self.buzz_state == "pending" or any(
            state == "pending" for state in self.coding_agent_states.values()
        ):
            self.failure_details = []
            self._start_next_ai()
            return
        WELCOME_DONE_FLAG.touch()
        ready_agents = [
            agent for agent in CODING_AGENTS
            if self.coding_agent_states[agent["key"]] == "ready"
        ]
        ready_count = len(ready_agents) + (1 if self.buzz_state == "ready" else 0)
        if ready_count == 1 and self.buzz_state == "ready":
            try:
                subprocess.Popen(["shadowfetch-buzz", "open"])
            except OSError as error:
                QMessageBox.warning(
                    self, "Buzz is installed",
                    f"Buzz setup succeeded, but it could not be opened automatically:\n\n{error}")
        if ready_count == 1 and ready_agents:
            agent = ready_agents[0]
            command = [agent["helper"]]
            if agent["helper_tool"]:
                command.append(agent["helper_tool"])
            command.append("open")
            try:
                subprocess.Popen(command)
            except OSError as error:
                QMessageBox.warning(
                    self, f"{agent['name']} is installed",
                    f"{agent['name']} setup succeeded, but it could not be opened "
                    f"automatically:\n\n{error}")
        self.on_close()

    def _skip_buzz(self):
        if self.busy:
            return
        WELCOME_DONE_FLAG.touch()
        self.on_close()


class ShadowfetchWelcome(QMainWindow):
    def __init__(self, mode="wizard", catalog_section=None, pending=None,
                 watcher=None, force=False):
        super().__init__()
        self.setWindowTitle("Shadowfetch Linux - Welcome")
        self.setMinimumSize(QSize(940, 680))
        self.setStyleSheet(f"""
            QMainWindow {{ background-color: {BG}; }}
            QWidget {{ color: {TEXT}; }}
            QLabel {{ background: transparent; }}
            QCheckBox {{ spacing: 10px; }}
            QCheckBox::indicator {{
                width: 18px; height: 18px; border: 2px solid {BORDER};
                border-radius: 4px; background: {CARD};
            }}
            QCheckBox::indicator:checked {{
                border-color: {GOLD}; background: {GOLD};
            }}
            QRadioButton {{ spacing: 10px; }}
            QRadioButton::indicator {{
                width: 16px; height: 16px; border: 2px solid {MUTED};
                border-radius: 10px; background: {CARD};
            }}
            QRadioButton::indicator:checked {{
                border: 5px solid {GOLD}; background: {INK};
            }}
            QPushButton {{
                background-color: {GOLD}; color: {INK};
                font-weight: 700; padding: 11px 26px;
                border: none; border-radius: 7px;
            }}
            QPushButton:hover {{ background-color: {GOLD_HOVER}; }}
            QPushButton:pressed {{ background-color: {GOLD_PRESS}; }}
            QPushButton:disabled {{ background-color: #333a44; color: #6b727b; }}
            QProgressBar {{
                border: 1px solid {BORDER}; border-radius: 5px;
                background: #11161e; height: 10px; text-align: center; color: {MUTED};
            }}
            QProgressBar::chunk {{ background-color: {GOLD}; border-radius: 5px; }}
            QScrollArea {{ background: transparent; border: none; }}
            QScrollBar:vertical {{ background: transparent; width: 10px; margin: 2px; }}
            QScrollBar::handle:vertical {{ background: {BORDER}; border-radius: 5px; min-height: 24px; }}
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
        """)

        self.mode = mode
        self.force = force
        self.watcher = watcher or NMWatcher(self)
        self.catalog_data = load_catalog()
        self.sizes = load_sizes()

        self.accent_name = ACCENTS[0][0]
        self.accent_hex = ACCENTS[0][1]
        self.profiles = []
        self.flatpaks = []
        self.local_ai = {"choice": "none", "coding_agents": {}}

        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        if mode == "catalog":
            self.setWindowTitle("Shadowfetch Linux - Software Catalog")
            page = CatalogPage(self.catalog_data, self.sizes, self.watcher,
                               focus_section=catalog_section)
            self.stack.addWidget(page)
            return

        # Ignition: mandatory when the system stamp is absent, else additive.
        self.flow = IgnitionFlow(self.catalog_data, self.sizes, self.watcher,
                                 mandatory=not IGNITION_DONE.exists())
        self.flow.closed.connect(self._ignition_closed)

        self.catalog_page = CatalogPage(
            self.catalog_data, self.sizes, self.watcher,
            on_back=lambda: self.stack.setCurrentWidget(self.welcome))

        show_badge = not IGNITION_DONE.exists()
        self.welcome = WelcomePage(
            lambda: self.stack.setCurrentWidget(self.element_page),
            on_ignition=(lambda: self.stack.setCurrentWidget(self.flow))
            if show_badge else None,
            on_catalog=lambda: self.stack.setCurrentWidget(self.catalog_page),
            on_guide=open_system_guide,
            on_workbench=open_workbench)
        self.element_page = ElementPage(
            lambda: self.stack.setCurrentWidget(self.profile))
        self.profile = ProfilePage(self._got_profiles)
        self.wifi = WiFiPage(lambda: self.stack.setCurrentWidget(self.graphics))
        self.graphics = GraphicsPage(lambda: self.stack.setCurrentWidget(self.accent))
        self.accent = AccentPage(self._got_accent)
        self.apps = AppsPage(self._got_apps)
        self.buzz = BuzzPage(self._got_buzz)
        self.install = InstallPage(self.close)

        for w in (self.flow, self.welcome, self.element_page, self.profile, self.wifi,
                  self.graphics, self.accent, self.apps, self.buzz,
                  self.install, self.catalog_page):
            self.stack.addWidget(w)

        if mode == "ignition":
            self.stack.setCurrentWidget(self.flow)
            if pending:
                self.flow.start_reoffer(pending)
        else:
            self.stack.setCurrentWidget(self.welcome)

    def closeEvent(self, event):
        install = getattr(self, "install", None)
        if install is not None and install.busy:
            QMessageBox.information(
                self,
                "Setup is still running",
                "Wait for the current setup step to finish, or use Cancel setup.",
            )
            event.ignore()
            return
        super().closeEvent(event)

    def _ignition_closed(self, outcome: str):
        if outcome == "deferred":
            self.close()
            return
        # completed / skipped / saved: continue into the one-time welcome
        # flow if it has not run for this user, otherwise we are done.
        if not WELCOME_DONE_FLAG.exists() or self.force:
            self.stack.setCurrentWidget(self.welcome)
        else:
            self.close()

    def _got_profiles(self, profiles):
        self.profiles = profiles
        self.apps.apply_profiles(profiles)
        self.buzz.apply_profiles(profiles)
        self.stack.setCurrentWidget(self.wifi)

    def _got_accent(self, name, hexc):
        self.accent_name, self.accent_hex = name, hexc
        self.stack.setCurrentWidget(self.apps)

    def _got_apps(self, flatpaks):
        self.flatpaks = flatpaks
        self.stack.setCurrentWidget(self.buzz)

    def _got_buzz(self, local_ai):
        self.local_ai = local_ai
        self.stack.setCurrentWidget(self.install)
        self.install.start(self.accent_name, self.accent_hex, self.flatpaks,
                           self.local_ai)


class SessionController(QObject):
    """Owns the window and the resident wait-for-connectivity state.

    Judge fold (offline-to-online dead air): when a saved offline choice is
    pending, this process stays alive after the window closes, subscribed to
    NetworkManager connectivity. The moment connectivity reaches FULL the
    single re-confirmation card pops - in-session, no re-login.
    """
    def __init__(self, app, mode, catalog_section=None, force=False):
        super().__init__()
        self.app = app
        self.mode = mode
        self.catalog_section = catalog_section
        self.force = force
        self.watcher = NMWatcher(self)
        self.win = None
        app.lastWindowClosed.connect(self._last_window_closed)
        self.watcher.changed.connect(self._connectivity)

    def start(self):
        if self.mode == "exit":
            QTimer.singleShot(0, self.app.quit)
        elif self.mode == "catalog":
            self._show("catalog")
        elif self.mode == "pending":
            if self.watcher.is_online():
                self._show("ignition", pending=load_pending())
            # else: stay resident; the NM signal pops the re-offer card.
        elif self.mode in ("ignition", "wizard"):
            self._show(self.mode)

    def _show(self, mode, pending=None):
        self.win = ShadowfetchWelcome(
            mode=mode, catalog_section=self.catalog_section, pending=pending,
            watcher=self.watcher, force=self.force)
        self.win.show()
        if mode in ("ignition", "wizard"):
            # Plasma's splash can take focus after an autostart window maps.
            # Reclaim it once, after the splash has normally finished.
            QTimer.singleShot(2500, self._activate_window)

    def _activate_window(self):
        win = self.win
        if win is None or not win.isVisible():
            return
        try:
            win.raise_()
            win.activateWindow()
        except Exception:  # noqa: BLE001
            pass

    def _connectivity(self, online: bool):
        if online and self.win is None:
            pending = load_pending()
            if pending is not None:
                self._show("ignition", pending=pending)
                self._activate_window()

    def _last_window_closed(self):
        self.win = None
        if load_pending() is not None:
            # An unfulfilled saved choice: keep listening for connectivity
            # so a reconnect re-offers without a re-login.
            return
        self.app.quit()


def main():
    argv = sys.argv[1:]
    force = "--force" in argv
    catalog_section = None
    if "--catalog" in argv:
        i = argv.index("--catalog")
        nxt = argv[i + 1] if i + 1 < len(argv) else ""
        mapping = {"media": "media", "presets": "presets", "ai": "ai",
                   "power": "power"}
        catalog_section = mapping.get(nxt, "media")
    open_ignition = "--ignition" in argv

    if catalog_section is not None:
        mode = "catalog"
    elif open_ignition:
        mode = "ignition"
    elif load_pending() is not None:
        # A saved offline choice is pending: fulfilment of a user-initiated
        # selection, not a nag - runs at every login until fulfilled.
        mode = "pending"
    elif not IGNITION_DONE.exists() and not IGNITION_SKIP.exists():
        mode = "ignition"
    elif WELCOME_DONE_FLAG.exists() and not force:
        return 0
    else:
        mode = "wizard"

    app = QApplication(sys.argv)
    app.setApplicationName("Shadowfetch Welcome")
    # Quit is decided by the controller: a pending offline choice keeps the
    # process resident so the NM signal can re-offer without re-login.
    app.setQuitOnLastWindowClosed(False)
    controller = SessionController(app, mode, catalog_section=catalog_section,
                                   force=force)
    controller.start()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
