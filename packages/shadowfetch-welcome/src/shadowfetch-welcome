# ---- Fire and Ice (3.1) --------------------------------------------------
# The element is decided before this window exists: at the boot menu
# (sf.element= on the kernel command line -> /etc/shadowfetch/element), or by
# the user afterwards (~/.config/shadowfetch/element, or the Element page in
# this very wizard). Everything downstream — palette, profile order, agent
# network defaults — reads ONE value so the system never looks half-switched.
def load_element() -> str:
    v = os.environ.get("SHADOWFETCH_ELEMENT", "").strip().lower()
    for candidate in (
        Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
        / "shadowfetch" / "element",
        Path("/etc/shadowfetch/element"),
    ):
        if v:
            break
        try:
            v = candidate.read_text().strip().lower()
        except OSError:
            continue
    return v if v in ("fire", "ice") else "fire"


