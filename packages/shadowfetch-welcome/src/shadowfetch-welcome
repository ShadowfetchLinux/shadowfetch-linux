class CatalogPage(QWidget):
    """The one-click media and preset catalog, plus verified Local AI entry."""

    def __init__(self, catalog: dict, sizes: dict, watcher: NMWatcher,
                 focus_section=None, on_back=None, parent=None):
        super().__init__(parent)
        self.catalog = catalog
        self.sizes = sizes
        self.watcher = watcher
        self._section_headers = {}

        lay = QVBoxLayout(self)
        lay.setContentsMargins(48, 36, 48, 28)
        lay.setSpacing(10)

        head = QHBoxLayout()
        head.addWidget(_label("Software catalog", 24, TEXT, bold=True))
        head.addStretch(1)
        if on_back is not None:
            back = QPushButton("← Back")
            back.setFixedHeight(38)
            back.clicked.connect(on_back)
            head.addWidget(back)
        lay.addLayout(head)
        lay.addWidget(_label(
            "Apps and presets install from the pinned Shadowfetch mirrors. "
            "Buzz manages hardware-aware open model selection and download. "
            "Nothing downloads until you confirm.",
            12, MUTED, wrap=True))

        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        container = QWidget()
        vbox = QVBoxLayout(container)
        vbox.setContentsMargins(0, 4, 6, 4)
        vbox.setSpacing(10)

        scan = hwscan_cached()
        nvidia = hwscan_has_nvidia(scan)
        btrfs = root_is_btrfs()

        by_section = {key: [] for key, _ in CATALOG_SECTIONS}
        for cid, rec in sorted(self.catalog.items()):
            if cid.startswith("ignition-") or rec.get("section") == "workbench":
                continue  # Ignition and Workbench own their profile records
            by_section.setdefault(catalog_section_of(rec), []).append(rec)

        for key, title in CATALOG_SECTIONS:
            header = _label(title, 15, GOLD, bold=True)
            self._section_headers[key] = header
            vbox.addSpacing(8)
            vbox.addWidget(header)
            recs = by_section.get(key, [])
            shown = 0
            if key == "ai":
                vbox.addWidget(self._local_ai_card())
                shown += 1
            for rec in recs:
                requires = rec.get("requires") or []
                if "nvidia" in requires and not nvidia:
                    # Shown only when the firstboot GPU-detect found NVIDIA.
                    continue
                vbox.addWidget(self._entry_card(rec, btrfs))
                shown += 1
            if shown == 0:
                vbox.addWidget(_label("Nothing in this section yet.",
                                      11, MUTED))
        vbox.addStretch(1)
        self.scroll.setWidget(container)
        lay.addWidget(self.scroll, 1)

        if focus_section:
            QTimer.singleShot(0, lambda: self._focus(focus_section))

    def _focus(self, section: str):
        header = self._section_headers.get(section)
        if header is not None:
            self.scroll.ensureWidgetVisible(header, 0, 40)

    def _local_ai_card(self) -> QWidget:
        card = Card()
        row = QHBoxLayout(card)
        row.setContentsMargins(16, 12, 16, 12)
        text = QVBoxLayout()
        text.setSpacing(2)
        text.addWidget(_label("Buzz shared compute", 13, TEXT, bold=True))
        text.addWidget(_label(
            "Buzz ranks open-source models for this computer, shows the "
            "recommended fit, and asks before downloading. Its model endpoint "
            "stays on this machine.",
            11, MUTED, wrap=True))
        text.addWidget(_label(
            "Official Buzz model catalog - native shared compute - localhost only",
            10, MUTED, wrap=True))
        row.addLayout(text, 1)
        button = QPushButton("Open Local AI")
        button.setFixedHeight(38)
        button.clicked.connect(self._open_local_ai)
        row.addWidget(button, 0, Qt.AlignmentFlag.AlignVCenter)
        return card

    def _open_local_ai(self):
        for command in (
                ["shadowfetch-control", "--page", "local-ai"],
                ["konsole", "-e", "shadowfetch-buzz", "setup"]):
            if not shutil.which(command[0]):
                continue
            try:
                subprocess.Popen(command)
                return
            except OSError:
                continue
        QMessageBox.information(
            self, "Local AI unavailable",
            "The Local AI tools are not installed on this system.")

    def _entry_card(self, rec: dict, btrfs: bool) -> QWidget:
        card = Card()
        row = QHBoxLayout(card)
        row.setContentsMargins(16, 12, 16, 12)
        txt = QVBoxLayout()
        txt.setSpacing(2)
        txt.addWidget(_label(rec.get("name", rec["id"]), 13, TEXT, bold=True))
        txt.addWidget(_label(rec.get("blurb", ""), 11, MUTED, wrap=True))

        meta = []
        kind = rec.get("kind")
        meta.append(bundle_size_line(rec, self.sizes))
        if rec.get("license"):
            meta.append(str(rec["license"]))
        txt.addWidget(_label(" - ".join(meta), 10, MUTED, wrap=True))
        row.addLayout(txt, 1)

        btn = QPushButton()
        btn.setFixedHeight(38)
        requires = rec.get("requires") or []
        if kind in ("apt", "preset"):
            pkgs = rec.get("packages") or []
            installed = dpkg_installed(pkgs)
            if pkgs and len(installed) == len(pkgs):
                btn.setText("Installed")
                btn.setEnabled(False)
            elif "btrfs" in requires and not btrfs:
                btn.setText("Needs Btrfs")
                btn.setEnabled(False)
            else:
                btn.setText("Install")
                btn.clicked.connect(lambda _c, r=rec, b=btn: self._install(r, b))
        elif kind == "template":
            btn.setText("Create workspace...")
            btn.clicked.connect(lambda _c, r=rec: self._template(r))
        else:
            btn.setText("Unavailable")
            btn.setEnabled(False)
        row.addWidget(btn, 0, Qt.AlignmentFlag.AlignVCenter)
        return card

    def _install(self, rec: dict, btn: QPushButton):
        if not self.watcher.is_online():
            QMessageBox.information(
                self, "Offline",
                "This install needs a connection. Nothing was changed - "
                "try again once you are online.")
            return
        dlg = InstallDialog(rec, self)
        dlg.exec()
        if dlg.ok:
            btn.setText("Installed")
            btn.setEnabled(False)

    def _template(self, rec: dict):
        for cmd in (["shadowfetch-agent-workspace"],
                    ["konsole", "-e", "shadowfetch-agent-workspace"]):
            if shutil.which(cmd[0]):
                try:
                    subprocess.Popen(cmd)
                    return
                except Exception:  # noqa: BLE001
                    continue
        QMessageBox.information(
            self, "Not installed",
            "The workspace tool is not installed on this system.")


