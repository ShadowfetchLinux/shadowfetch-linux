def strip_terminal_escapes(value):
    """Return one terminal line suitable for a graphical status label."""
    clean = re.sub(r"\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])", "", value or "")
    return clean.replace("\r", "").strip()


def detect_display_vendor(lspci_numeric):
    """Classify PCI display devices from stable numeric vendor IDs."""
    vendor_map = {
        "10de": "nvidia",
        "1002": "amd",
        "8086": "intel",
        "1af4": "virtual",
        "1234": "virtual",
    }
    detected = {
        vendor_map.get(match.group(1).lower(), "unknown")
        for match in re.finditer(
            r"\b03(?:00|02|80):\s+([0-9a-fA-F]{4}):[0-9a-fA-F]{4}\b",
            lspci_numeric or "",
        )
    }
    for preferred in ("nvidia", "amd", "intel", "virtual"):
        if preferred in detected:
            return preferred
    return "unknown"


def open_system_guide():
    """Open the native Guide surface, with a text fallback if it is absent."""
    control = shutil.which("shadowfetch-control")
    if control:
        try:
            subprocess.Popen([control, "--page", "guide"])
            return True
        except OSError:
            pass
    passport = shutil.which("shadowfetch-passport")
    terminal = shutil.which("konsole") or shutil.which("x-terminal-emulator")
    if passport and terminal:
        try:
            subprocess.Popen([terminal, "-e", passport])
            return True
        except OSError:
            pass
    return False


def open_workbench():
    """Open the flagship production workspace surface."""
    control = shutil.which("shadowfetch-control")
    if not control:
        return False
    try:
        subprocess.Popen([control, "--page", "workbench"])
        return True
    except OSError:
        return False

