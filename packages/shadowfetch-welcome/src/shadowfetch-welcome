class CommandWorker(QThread):
    """Run cancellable argv commands off the UI thread."""
    progress = pyqtSignal(str)
    finished = pyqtSignal(int)

    def __init__(self, commands):
        super().__init__()
        self.commands = commands
        self.process = None
        self.cancel_requested = False
        self.cancel_escalation_started = False

    def cancel(self):
        self.cancel_requested = True
        process = self.process
        if process is not None and process.poll() is None:
            self._begin_cancel(process)

    def _begin_cancel(self, process):
        if self.cancel_escalation_started:
            return
        self.cancel_escalation_started = True
        try:
            os.killpg(process.pid, signal.SIGINT)
        except (OSError, ProcessLookupError):
            return
        threading.Thread(
            target=self._escalate_cancel,
            args=(process,),
            daemon=True,
        ).start()

    @staticmethod
    def _escalate_cancel(process):
        for delay, sig in ((5, signal.SIGTERM), (5, signal.SIGKILL)):
            time.sleep(delay)
            if process.poll() is not None:
                return
            try:
                os.killpg(process.pid, sig)
            except (OSError, ProcessLookupError):
                return

    def run(self):
        rc = 0
        for cmd in self.commands:
            if self.cancel_requested:
                rc = 130
                break
            self.progress.emit(cmd[0] + " ...")
            try:
                process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    start_new_session=True,
                )
                self.process = process
                if self.cancel_requested and process.poll() is None:
                    self._begin_cancel(process)
                stdout, stderr = process.communicate()
                self.process = None
                if self.cancel_requested:
                    rc = 130
                    break
                if process.returncode != 0:
                    rc = process.returncode
                    msg = (stderr or stdout).strip().splitlines()
                    self.progress.emit("  ! " + (msg[-1][:160] if msg else "failed"))
            except FileNotFoundError:
                rc = 1
                self.progress.emit(f"  ! {cmd[0]} not found")
            except Exception as e:  # noqa: BLE001 - best effort, keep going
                rc = 1
                self.progress.emit(f"  ! {e}")
            finally:
                self.process = None
        self.finished.emit(rc)


class StreamingCommandWorker(QThread):
    """Run one long command and stream its combined output to the UI."""
    progress = pyqtSignal(str)
    finished = pyqtSignal(int)

    def __init__(self, command):
        super().__init__()
        self.command = command
        self.process = None
        self.cancel_requested = False
        self.cancel_escalation_started = False

    def cancel(self):
        self.cancel_requested = True
        process = self.process
        if process is not None and process.poll() is None:
            self._begin_cancel(process)

    def _begin_cancel(self, process):
        if self.cancel_escalation_started:
            return
        self.cancel_escalation_started = True
        try:
            os.killpg(process.pid, signal.SIGINT)
        except (OSError, ProcessLookupError):
            return
        threading.Thread(
            target=self._escalate_cancel,
            args=(process,),
            daemon=True,
        ).start()

    @staticmethod
    def _escalate_cancel(process):
        for delay, sig in ((5, signal.SIGTERM), (5, signal.SIGKILL)):
            time.sleep(delay)
            if process.poll() is not None:
                return
            try:
                os.killpg(process.pid, sig)
            except (OSError, ProcessLookupError):
                return

    def run(self):
        try:
            process = subprocess.Popen(
                self.command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                start_new_session=True,
            )
            self.process = process
            if self.cancel_requested and process.poll() is None:
                self._begin_cancel(process)
        except OSError as error:
            self.progress.emit(f"Could not start setup: {error}")
            self.finished.emit(1)
            return
        assert process.stdout is not None
        for line in iter(process.stdout.readline, ""):
            clean = strip_terminal_escapes(line.rstrip("\n"))
            if clean:
                self.progress.emit(clean[:500])
        process.stdout.close()
        code = process.wait()
        self.process = None
        self.finished.emit(130 if self.cancel_requested else code)


