#!/usr/bin/env python3
"""shadowfetch-ai-ignition - turnkey first-boot local AI.

Shadowfetch's own review said "AI-ready, not turnkey" (nouveau on an RTX 5080,
manual model setup). Ignition closes that gap: it reads what this machine can
run from the System Passport / hwscan, recommends a model that actually FITS the
GPU, and hands you the exact consent-gated command to install it through Buzz's
private local-model setup. Nothing downloads until you say yes; the catalog is
Apache-2.0 / permissive-open only, so nothing here carries a redistribution
trap.

  shadowfetch-ai-ignition recommend            # detect VRAM, pick a model
  shadowfetch-ai-ignition recommend --vram-gb 16
  shadowfetch-ai-ignition catalog              # show the whole catalog
  shadowfetch-ai-ignition plan  <model-id>     # print the consent-gated setup

This command only reads and recommends. The actual download happens after your
explicit confirmation, exactly like every other model path in Shadowfetch.
"""
from __future__ import annotations
import argparse, json, os, subprocess, sys
from pathlib import Path

CATALOG = os.environ.get("SHADOWFETCH_AI_CATALOG",
                         "/usr/share/shadowfetch/ai-ignition/models.json")
VERSION = "3.5.0"


def load_catalog() -> dict:
    p = Path(CATALOG)
    if not p.exists():
        # allow running from the source tree
        here = Path(__file__).resolve()
        for up in here.parents:
            cand = up / "data/usr/share/shadowfetch/ai-ignition/models.json"
            if cand.exists():
                p = cand; break
    return json.loads(p.read_text())


def detect_vram_gb() -> float:
    """Best-effort VRAM read. Prefer the Passport; fall back to nvidia-smi; else 0."""
    for cand in ("shadowfetch-passport", "/usr/bin/shadowfetch-passport"):
        try:
            r = subprocess.run([cand, "--json"], capture_output=True, text=True, timeout=15)
            if r.returncode == 0 and r.stdout.strip():
                d = json.loads(r.stdout)
                v = _dig(d, "vram_gb", "gpu_vram_gb", "local_ai", "graphics")
                if v:
                    return float(v)
        except (OSError, ValueError, json.JSONDecodeError, subprocess.SubprocessError):
            pass
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=memory.total",
                            "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip():
            return round(int(r.stdout.split("\n")[0]) / 1024, 1)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return 0.0


def _dig(d, *keys):
    # shallow search for the first numeric value under any of the given keys
    if isinstance(d, dict):
        for k, v in d.items():
            if k in keys and isinstance(v, (int, float)):
                return v
            r = _dig(v, *keys)
            if r is not None:
                return r
    elif isinstance(d, list):
        for v in d:
            r = _dig(v, *keys)
            if r is not None:
                return r
    return None


def fits(model: dict, vram_gb: float) -> bool:
    need = model.get("min_vram_gb")  # per-model override (e.g. Devstral in a low tier)
    if need is not None:
        return vram_gb >= need
    size = model.get("size_gb", 0)
    if vram_gb == 0:
        # CPU only: cap at ~4 GB weights so the pick is actually usable, not a
        # 130 GB MoE that "fits" because there is no VRAM ceiling to check.
        return size <= 4.0
    # require the quantized weights to fit with ~1.3x runtime overhead
    return vram_gb >= size * 1.3


def recommend(vram_gb: float, catalog: dict):
    # Fit is the real constraint; tier min_vram is only display grouping. Consider
    # every model that fits, then pick the largest-that-fits, with Apache-2.0
    # breaking ties (permissive-open is the safe default; see the catalog note).
    picks = []
    for tier in catalog["tiers"]:
        for m in tier["models"]:
            if fits(m, vram_gb):
                picks.append((tier, m))
    if not picks:
        cpu = catalog["tiers"][0]
        picks = [(cpu, cpu["models"][0])]

    def score(tm):
        m = tm[1]
        apache = 1 if m.get("license") == "apache-2.0" else 0
        # Apache-2.0 first (the safe default), then the largest that fits.
        return (apache, round(m.get("size_gb", 0), 1))
    best = max(picks, key=score)
    return best, picks


def cmd_recommend(args, catalog):
    vram = args.vram_gb if args.vram_gb is not None else detect_vram_gb()
    (tier, best), picks = recommend(vram, catalog)
    where = "CPU only (no GPU VRAM detected)" if vram == 0 else f"{vram:g} GB GPU VRAM"
    print(f"Detected: {where}")
    print(f"\nRecommended: {best['name']}  [{best['license']}, {best['quant']}, ~{best['size_gb']:g} GB]")
    print(f"  why: {best['use']}")
    print(f"  class: {tier['class']}")
    others = [m['name'] for _, m in picks if m['id'] != best['id']]
    if others:
        print("  also fits: " + ", ".join(sorted(set(others))))
    print(f"\nInstall it (consent-gated) with:\n  shadowfetch-ai-ignition plan {best['id']}")
    return 0


def cmd_catalog(args, catalog):
    print(f"Shadowfetch AI Ignition catalog  ({catalog['engine']})")
    for tier in catalog["tiers"]:
        head = "CPU" if tier["min_vram_gb"] == 0 else f">={tier['min_vram_gb']} GB VRAM"
        print(f"\n[{tier['class']}]  {head}")
        for m in tier["models"]:
            print(f"  {m['id']:18} {m['name']:22} {m['license']:12} {m['quant']:7} ~{m['size_gb']:g} GB")
    return 0


def cmd_plan(args, catalog):
    model = None
    for tier in catalog["tiers"]:
        for m in tier["models"]:
            if m["id"] == args.model_id:
                model = m; break
    if not model:
        print(f"unknown model id: {args.model_id} (see: shadowfetch-ai-ignition catalog)", file=sys.stderr)
        return 2
    print(f"Setup plan for {model['name']} ({model['license']}, ~{model['size_gb']:g} GB):")
    print("  1. Buzz prepares private local inference (loopback-only, no account).")
    print(f"  2. Download {model['id']} weights ({model['quant']}) after your confirmation.")
    print("  3. Serve it on the local OpenAI-compatible API; point agents at it.")
    print("\nThis prints the plan only. To proceed, Shadowfetch asks for explicit")
    print("confirmation in Welcome > AI workspace, or in Control Center > Local AI.")
    print("No weights are downloaded by this command.")
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="shadowfetch-ai-ignition",
        description="Turnkey first-boot local AI: recommend a model that fits this machine.")
    p.add_argument("--version", action="store_true")
    sub = p.add_subparsers(dest="cmd")
    r = sub.add_parser("recommend"); r.add_argument("--vram-gb", type=float, default=None)
    sub.add_parser("catalog")
    pl = sub.add_parser("plan"); pl.add_argument("model_id")
    a = p.parse_args(argv)
    if a.version:
        print(f"shadowfetch-ai-ignition (Shadowfetch Linux) {VERSION}"); return 0
    catalog = load_catalog()
    if a.cmd == "recommend": return cmd_recommend(a, catalog)
    if a.cmd == "catalog":   return cmd_catalog(a, catalog)
    if a.cmd == "plan":      return cmd_plan(a, catalog)
    p.print_help(); return 2


if __name__ == "__main__":
    raise SystemExit(main())
