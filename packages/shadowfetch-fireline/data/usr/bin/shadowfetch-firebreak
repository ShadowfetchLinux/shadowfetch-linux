#!/usr/bin/env python3
"""Firebreak 4: private filesystem and environment for a named workspace.

A fresh mount namespace exposes system runtimes, selected public /etc files,
private temporary/home directories and exactly one writable workspace. Additional
read access and individual credentials require explicit command-line grants.
"""
from __future__ import annotations
import argparse
import datetime
import json
import os
import pwd
import re
from pathlib import Path
import resource
import shutil
import socket
import signal
import subprocess
import sys
import tempfile
import time
import uuid

VERSION = "4.0.0"
CREDENTIALS = {"OPENAI_API_KEY", "CODEX_API_KEY", "ANTHROPIC_API_KEY", "XAI_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY", "GROQ_API_KEY", "MISTRAL_API_KEY", "DEEPSEEK_API_KEY", "OPENROUTER_API_KEY", "GITHUB_TOKEN", "GH_TOKEN", "GITLAB_TOKEN", "HF_TOKEN", "HUGGING_FACE_HUB_TOKEN", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "CLOUDFLARE_API_TOKEN", "CF_API_TOKEN", "DIGITALOCEAN_TOKEN", "NPM_TOKEN", "PYPI_TOKEN", "DOCKER_PASSWORD", "SSH_AUTH_SOCK"}
PUBLIC_ETC = ("ld.so.cache", "ld.so.conf", "ld.so.conf.d", "alternatives", "ssl/certs", "ca-certificates", "resolv.conf", "hosts", "nsswitch.conf", "passwd", "group", "localtime", "timezone", "mime.types", "fonts")

class Error(Exception):
    pass

def redact(text):
    """Strip credentials from text on its way to the terminal.

    Firebreak's error messages quote a child process's stderr (a failed
    checkpoint, a failed namespace probe), so they are an output path like any
    other. The one shared implementation lives in shadowfetch-missions -- which
    Depends on THIS package, so it cannot be a hard dependency in this
    direction. Use it when it is installed.

    Without it, fall back to striking out the exact values of the credentials
    this process was actually handed. That is genuinely narrower than the
    shared rules (no vendor prefixes, no PEM blocks, no Authorization headers),
    but it covers the only secret material Firebreak itself is given, and it is
    never a no-op pretending to be a redactor.
    """
    text = str(text)
    locations = [Path("/usr/lib/shadowfetch/missions")]
    locations += [parent / "packages/shadowfetch-missions/data/usr/lib/shadowfetch/missions"
                  for parent in Path(__file__).resolve().parents]
    for location in locations:
        if (location / "sf_redact.py").is_file():
            if str(location) not in sys.path:
                sys.path.insert(0, str(location))
            try:
                from sf_redact import redact as shared
            except ImportError:
                break
            return shared(text)
    for name in sorted(CREDENTIALS - {"SSH_AUTH_SOCK"}):
        value = os.environ.get(name)
        if value and len(value) >= 8:
            text = text.replace(value, "[REDACTED]")
    return text

def root():
    return Path(os.environ.get("SHADOWFETCH_AGENT_WORKSPACES", str(Path.home() / "Workspaces"))).expanduser().resolve()

# The audit directory used to be chosen by $XDG_STATE_HOME. That variable is
# ambient: a desktop session, a systemd user unit or a container image sets it
# for reasons that have nothing to do with this program, and whatever launches
# Firebreak inherits it. A caller that can move the audit directory can make a
# session unrecorded, and with an ambient variable nobody has to have DECIDED
# that for it to happen. The canonical location now comes from the passwd
# entry, which this process cannot rewrite.
#
# One purpose-named variable still relocates it, because the test suite and a
# desktop session with an isolated state tree need some way to say so, and
# nothing sets this name by accident: a relocation is therefore always
# deliberate, and every record written under one says it was relocated. That
# makes relocation VISIBLE, not impossible -- anything running as this uid can
# set the variable, and can equally unlink the file afterwards. Only a copy
# that leaves this uid's trust domain closes that, which is the journald
# mirror in ADR-0010.
STATE_ENV = "SHADOWFETCH_FIREBREAK_STATE"


def passwd_home():
    """This user's home from the passwd database, never from $HOME."""
    try:
        entry = pwd.getpwuid(os.geteuid())
    except KeyError as exc:
        raise Error("This user has no passwd entry, so the audit directory cannot be resolved") from exc
    home = (entry.pw_dir or "").strip()
    if not home.startswith("/"):
        raise Error("The passwd entry gives no absolute home directory, so the audit directory cannot be resolved")
    return Path(home)


def state():
    override = os.environ.get(STATE_ENV, "").strip()
    if override:
        path = Path(override).expanduser()
        if not path.is_absolute():
            raise Error(STATE_ENV + " must name an absolute directory")
    else:
        path = passwd_home() / ".local/state/shadowfetch/firebreak"
    path = path.resolve()
    if path == root() or root() in path.parents:
        raise Error("Audit state must be outside the workspace root")
    path.mkdir(parents=True, mode=0o700, exist_ok=True)
    # Somebody else's directory is not ours to write session records into,
    # whoever pointed us at it.
    if path.stat().st_uid != os.geteuid():
        raise Error("The audit directory belongs to another user; session records were not written")
    path.chmod(0o700)
    return path


def state_relocated():
    """Whether records are going somewhere other than the canonical directory."""
    return bool(os.environ.get(STATE_ENV, "").strip())

def element():
    value = os.environ.get("SHADOWFETCH_ELEMENT", "")
    if not value:
        for path in (Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "shadowfetch/element", Path("/etc/shadowfetch/element")):
            if path.is_file():
                value = path.read_text().strip()
                break
    return "ice" if value == "ice" else "fire"

def workspace(name):
    base = root()
    if name:
        if Path(name).name != name or name.startswith(".") or "\\" in name or len(name) > 160 or any(ord(char) < 32 or ord(char) == 127 for char in name):
            raise Error("Workspace must be a direct non-hidden folder name")
        candidate = base / name
    else:
        current = Path.cwd().resolve()
        try:
            rel = current.relative_to(base)
            candidate = base / rel.parts[0]
        except (ValueError, IndexError):
            raise Error("Choose --workspace NAME under " + str(base))
    if candidate.is_symlink() or candidate.resolve().parent != base or not candidate.is_dir():
        raise Error("Workspace is missing or escapes the configured root")
    return candidate.resolve()

def checkpoint_bin():
    override = os.environ.get("SHADOWFETCH_CHECKPOINT_BIN")
    if override:
        return override
    return (trusted_which("shadowfetch-checkpoint")
            or str(Path(__file__).with_name("shadowfetch-checkpoint")))

def read_grants(values, ws):
    grants = []
    reserved = (Path("/proc"), Path("/dev"), Path("/run"), Path("/sys"), Path("/home/agent"), state(), root() / ".sf-checkpoints")
    for value in values:
        candidate = Path(value).expanduser()
        resolved = candidate.resolve()
        if not candidate.is_absolute() or not resolved.exists():
            raise Error("Read grants must name an existing absolute path")
        if len(resolved.parts) < 3:
            raise Error("Read grants cannot expose a filesystem root or top-level directory")
        if resolved == ws or resolved in ws.parents or ws in resolved.parents:
            raise Error("Read grant overlaps the writable workspace")
        if any(resolved == item or resolved in item.parents or item in resolved.parents for item in reserved):
            raise Error("Read grant overlaps protected sandbox/controller storage")
        if resolved == Path.home().resolve():
            raise Error("Grant selected files or a specific runtime folder, never the whole home directory")
        if not (resolved.is_file() or resolved.is_dir()):
            raise Error("Read grants support regular files and directories only")
        grants.append(resolved)
    return grants

# A session id becomes a systemd unit name (--unit=), a filename, and an
# environment variable inside the sandbox. All three are injection surfaces, so
# the shape is checked rather than trusted: the orchestrator is not hostile, but
# "the caller is trusted" is the assumption this codebase keeps finding was
# wrong somewhere else.
SESSION_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")


def session_id(supplied):
    """The orchestrator's id if it gave one, otherwise mint our own.

    Mission Control mints the id BEFORE execution so that a crash between
    launching and recording still leaves a correlatable identity. When it does,
    Firebreak adopts it: one identity, not two that have to be joined later.
    """
    if supplied is None or supplied == "":
        return ("fb-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
                + "-" + uuid.uuid4().hex[:8])
    if not SESSION_ID.match(supplied):
        raise Error(
            "A session id must be 1-64 characters of letters, digits, hyphen or "
            "underscore, starting with a letter or digit. It names a systemd "
            "unit and a file, so its shape is not negotiable.")
    return supplied


# --------------------------------------------------------------------------- #
# Session records
# --------------------------------------------------------------------------- #
# One append-only JSON-lines file per session: a "started" record before the
# sandbox runs and an "ended" record when it stops. The previous version wrote
# a single object and REWROTE it at exit, so a running session could not be
# inspected at all, and a crash between the two writes left neither the start
# nor the end. Appending keeps the start whatever happens next, and a session
# with no "ended" record is itself the evidence that it did not finish.
RECORD_SCHEMA = 2

# The PATH the sandbox is given. Named once because the record claims to
# resolve the agent's program the way the sandbox will, and a second copy of
# this string would quietly make that claim false.
# Only root-owned directories. Firebreak's own readiness output is a security
# claim, and the checkpoint binary it invokes takes the snapshot that Undo later
# restores from -- neither may be chosen by whoever set PATH.
TRUSTED_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def trusted_which(name):
    """Resolve from trusted directories only. Never PATH."""
    return shutil.which(name, path=TRUSTED_PATH)


SANDBOX_PATH = "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

ENFORCED = "enforced"
PARTIAL = "partial"
NOT_ENFORCED = "not_enforced"
OBSERVED = "observed"
NOT_APPLICABLE = "not_applicable"


def append_record(path, record):
    """Add one line. O_APPEND, so a second writer cannot land on top of it."""
    line = json.dumps(record, sort_keys=True) + "\n"
    handle = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(handle, line.encode())
        # A record exists to survive the crash that ended the session it
        # describes, so it reaches the disk before that session starts.
        os.fsync(handle)
    finally:
        os.close(handle)
    os.chmod(path, 0o600)


def read_records(path):
    """Every record in one session file, including an unreadable tail.

    A truncated final line is what a crash mid-append looks like. It is
    reported rather than dropped: a reader that silently discards the evidence
    of a crash is worse than no reader.
    """
    text = path.read_text(errors="replace")
    try:
        legacy = json.loads(text)
    except ValueError:
        pass
    else:
        # Sessions recorded before this file became append-only are one
        # pretty-printed object; read them rather than reporting every line of
        # them as damage.
        if isinstance(legacy, dict):
            legacy.setdefault("record", "legacy")
            return [legacy]
    found = []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            found.append(json.loads(line))
        except ValueError:
            found.append({"record": "unreadable", "session": path.stem,
                          "line": number, "characters": len(line)})
    return found


# Option names that are followed by a secret. An agent command is supplied by
# the caller, so this cannot be exhaustive -- it is a floor, and the value-based
# strike below is what catches the rest.
SECRET_OPTIONS = ("--api-key", "--apikey", "--token", "--password", "--secret",
                  "--auth", "--bearer", "--credential", "--key")


def redacted_argv(argv, *, values=()):
    """The argv with credential VALUES struck out.

    Three passes, because each catches what the others cannot:

    1. POSITION after `--setenv NAME` for a known credential identity. This is
       how Firebreak itself injects a value, and it is exact.
    2. POSITION after an option whose NAME says a secret follows. An agent
       command is caller-supplied, so this list is a floor rather than a
       guarantee.
    3. VALUE. Any token equal to a credential value we actually resolved is
       struck wherever it appears, including `--api-key=VALUE` and bare
       positional forms.

    Only then the text redactor, which recognises shapes like sk-... but cannot
    recognise a short or arbitrary value -- and this record outlives the
    process, so "probably not a secret" is not good enough.
    """
    parts = [str(item) for item in argv]
    for index in range(len(parts) - 2):
        if parts[index] == "--setenv" and parts[index + 1] in CREDENTIALS:
            parts[index + 2] = "[REDACTED]"
    for index in range(len(parts) - 1):
        if parts[index].lower() in SECRET_OPTIONS:
            parts[index + 1] = "[REDACTED]"
    secrets = [str(v) for v in values if v and len(str(v)) >= 4]
    if secrets:
        cleaned = []
        for part in parts:
            for secret in secrets:
                if secret in part:
                    part = part.replace(secret, "[REDACTED]")
            cleaned.append(part)
        parts = cleaned
    return [redact(part) for part in parts]


def resolved_executable(program, ws):
    """The file the sandbox will exec, resolved the way the sandbox will.

    Against the sandbox's PATH and its working directory, not this process's:
    the same directories are bound into the sandbox at the same paths, so the
    lookup lands on the same file, while the host's PATH and cwd would not.
    OBSERVED, never enforced -- bwrap performs its own lookup at exec time and
    Firebreak does not pin argv[0] to this answer.
    """
    if not program:
        return None, "none"
    if "/" in program:
        base = Path(program) if program.startswith("/") else ws / program
        try:
            candidate = base.resolve()
        except OSError:
            return None, "unresolved"
        return (str(candidate), "literal-path") if candidate.exists() else (None, "unresolved")
    found = shutil.which(program, path=SANDBOX_PATH)
    if not found:
        return None, "unresolved"
    return str(Path(found).resolve()), "sandbox-path-lookup"


def parent_command():
    """The launching program's name.

    comm, not the parent's command line: that line can carry material with no
    business in an audit file, and the name answers what this field is for.
    """
    try:
        return (Path("/proc") / str(os.getppid()) / "comm").read_text().strip()
    except OSError:
        return None


def signal_name(number):
    try:
        return signal.Signals(number).name
    except ValueError:
        return str(number)


def applied(argv, *tokens):
    """Whether these tokens appear consecutively in the argv about to be spawned."""
    width = len(tokens)
    return any(tuple(argv[index:index + width]) == tokens
               for index in range(len(argv) - width + 1))


def network_namespaced(argv):
    """Whether this argv creates a network namespace. Two mechanisms count.

    bwrap's own --unshare-net makes one for posture 'none'. Posture 'allow'
    needs the namespace to exist BEFORE bwrap so the NAT and the egress filter
    can be installed into the one the sandbox will really run in, so an
    `unshare --net` helper makes it and bwrap inherits it -- and bwrap must not
    also be given --unshare-net there, or it would make a second, empty
    namespace and leave the filtered one behind. Reading only bwrap's flag would
    report a contained session as an uncontained one.
    """
    if applied(argv, "--unshare-net"):
        return True
    for index, value in enumerate(argv):
        if os.path.basename(value) == "unshare" and "--net" in argv[index:]:
            return True
    return False


def _status(active, mechanism, missing):
    return {"status": ENFORCED if active else NOT_ENFORCED,
            "mechanism": mechanism if active else missing}


def enforcement(argv, args, ws, grants, credentials, net):
    """What the argv about to be spawned actually applies, field by field.

    Read out of the BUILT argv rather than echoed back from the request. A
    record that repeated the request would make a control merely asked for
    indistinguishable from one the kernel is told to apply -- and two of these
    fields' mechanisms differ by posture, and saying which one ran is the
    whole point: an allowlist on an unshared namespace with no NAT is enforced
    by there being no route at all, which is a different fact from an nftables
    ruleset that permits three addresses.
    """
    egress = list(getattr(args, "egress_host", None) or [])
    masks = list(getattr(args, "mask_path", None) or [])
    binding = "--ro-bind" if args.workspace_mode == "read-only" else "--bind"
    report = {
        "workspace_mode": _status(
            applied(argv, binding, str(ws), str(ws)),
            "bwrap " + binding + " on the workspace",
            "the workspace is not bound the way " + args.workspace_mode + " asks"),
        "private_home": _status(
            applied(argv, "--clearenv") and applied(argv, "--dir", "/home/agent"),
            "bwrap --clearenv and a private /home/agent in a fresh mount namespace",
            "the sandbox gets no private home, or an environment that was not cleared"),
        "cpu_seconds": {
            "status": PARTIAL,
            "mechanism": "RLIMIT_CPU set on this process before exec. It is "
                         "per-process, so a task that forks gets a fresh budget "
                         "for each child"},
        "executable_path": {
            "status": OBSERVED,
            "mechanism": "the resolved path is what Firebreak's own lookup found. "
                         "bwrap resolves argv[0] itself at exec time and Firebreak "
                         "does not pin it"},
        "egress_allowlist": (
            {"status": NOT_APPLICABLE, "mechanism": "no egress host was asked for"}
            if not egress else
            {"status": ENFORCED,
             "mechanism": "no route exists: the sandbox has its own network "
                          "namespace and no NAT was attached to it, so every "
                          "destination is unreachable, allowlisted or not"}
            if net != "allow" else
            {"status": ENFORCED,
             "mechanism": "an nftables ruleset in the sandbox's own network "
                          "namespace, default DROP, permitting only the addresses "
                          "these names resolved to plus the NAT itself. Installed "
                          "before the sandbox starts, by the process that created "
                          "the namespace. Filtering is BY ADDRESS: a name is "
                          "resolved once, on the host, at launch -- an address set "
                          "that changes afterwards is no longer reachable until "
                          "the next run"}),
        "masked_paths": (
            {"status": NOT_APPLICABLE, "mechanism": "no masked path was asked for"}
            if not masks else
            _status(
                all(applied(argv, "--tmpfs", str(Path(os.path.realpath(m))))
                    or applied(argv, "--ro-bind", "/dev/null",
                               str(Path(os.path.realpath(m))))
                    for m in masks),
                "bwrap mounts over each masked path in the sandbox's own mount "
                "namespace: an empty tmpfs over a directory, /dev/null over a "
                "file. No cooperation from the payload is involved. A HARDLINK "
                "to the same inode under an unmasked name is still readable -- "
                "masking is by path",
                "a declared mask does not appear in the argv about to be spawned")),
        "memory_mb": _status(
            applied(argv, "--property=MemoryMax=" + str(args.memory_mb) + "M")
            and applied(argv, "--property=MemorySwapMax=0"),
            "systemd MemoryMax with MemorySwapMax=0, so the cap bounds the "
            "workload rather than the resident set",
            "the systemd scope does not carry this memory cap"),
        "processes": _status(
            applied(argv, "--property=TasksMax=" + str(args.processes)),
            "systemd TasksMax on the session's own cgroup",
            "the systemd scope does not carry this task cap"),
    }
    # Both postures now. 'allow' used to create no namespace at all and this
    # row said so; it reaches the internet through a user-space NAT attached to
    # its own namespace instead, so the host's loopback and abstract sockets are
    # out of reach either way.
    report["network"] = _status(
        network_namespaced(argv),
        ("the sandbox gets its own network namespace. "
         + ("bwrap --unshare-net makes it and posture 'none' leaves it empty"
            if net == "none" else
            "Names are resolved through the NAT's own forwarder at "
            + SLIRP_RESOLVER + ", because the host's resolver is a loopback "
            "stub that does not exist in this namespace -- so a query name can "
            "carry data out even where an address cannot. "
            "`unshare --user --net` makes it before bwrap, which inherits it "
            "rather than making a second one, so the slirp4netns NAT and the "
            "egress filter are installed into the namespace the sandbox really "
            "runs in. --disable-host-loopback keeps the host's loopback "
            "services and its abstract sockets out of reach")),
        "a network namespace was not created")
    report["read_grants"] = (
        {"status": NOT_APPLICABLE, "mechanism": "no read grant was asked for"}
        if not grants else
        _status(all(applied(argv, "--ro-bind", str(grant), str(grant)) for grant in grants),
                "bwrap --ro-bind per grant",
                "a grant that was asked for is not bound into the sandbox"))
    identities = [name for name in credentials if name in CREDENTIALS]
    report["credentials"] = _status(
        applied(argv, "--clearenv")
        and all(any(argv[index] == "--setenv" and argv[index + 1] == name
                    for index in range(len(argv) - 1))
                for name in identities),
        "bwrap --clearenv, then one --setenv per granted identity and nothing else",
        "the environment is not cleared, or a granted identity did not reach the sandbox")
    if getattr(args, "codex_account", False):
        report["account_mount"] = _status(
            any(argv[index] == "--bind" and argv[index + 2] == "/home/agent/.codex"
                for index in range(len(argv) - 2)),
            "bwrap --bind of the dedicated account home",
            "an account grant was asked for and no account home is bound")
    return report


def effective_network(args):
    """The posture this run will really have.

    Extracted because the launcher has to know it BEFORE the argv is built: a
    networked sandbox needs a resolver file that the argv has to bind, and the
    argv is built here.
    """
    return args.net or ("none" if element() == "ice" else "allow")


# The NAT's own DNS forwarder. slirp4netns --configure lays out 10.0.2.0/24 with
# the gateway at .2 and a DNS forwarder at .3, and the egress ruleset accepts
# that subnet because without it nothing resolves or routes.
#
# WHAT THIS BUYS AND WHAT IT COSTS. Without it a networked sandbox could open a
# socket to an address and could not turn a NAME into one: the host's
# /etc/resolv.conf points at 127.0.0.53, which inside the sandbox's own network
# namespace is the sandbox's own empty loopback. Every cloud provider addresses
# its API by name, so every turn failed at getaddrinfo. What it costs is stated
# rather than hidden: DNS queries leave through the forwarder, so a payload can
# encode data in query names and the destination allowlist -- which filters by
# address -- does not see it. An allowlist narrows where bytes can be SENT; it
# is not a claim that nothing can be signalled out.
SLIRP_RESOLVER = "10.0.2.3"
SLIRP_RESOLV_CONF = ("# Written by Shadowfetch Firebreak for a sandbox that has\n"
                     "# its own network namespace: the host's resolver is not\n"
                     "# reachable from inside one.\n"
                     "nameserver " + SLIRP_RESOLVER + "\n"
                     "options timeout:2 attempts:2\n")


def arguments(args, ws, sid, resolv=None):
    net = effective_network(args)
    grants = read_grants(args.read, ws)
    command = [trusted_program(BWRAP_PATHS, "bubblewrap"), "--die-with-parent", "--new-session", "--unshare-user", "--unshare-pid", "--unshare-uts", "--unshare-ipc", "--hostname", "firebreak", "--clearenv"]
    for system in ("/usr", "/bin", "/sbin", "/lib", "/lib64"):
        path = Path(system)
        if path.is_symlink():
            command += ["--symlink", os.readlink(path), system]
        elif path.exists():
            command += ["--ro-bind", system, system]
    command += ["--dir", "/etc"]
    for public in PUBLIC_ETC:
        # The host's resolver is deliberately NOT carried into a sandbox that
        # has its own network namespace: it names a loopback stub that only
        # exists in the host's namespace, so binding it hands the sandbox a
        # resolver that cannot answer. The caller supplies one that can.
        if public == "resolv.conf" and resolv is not None:
            continue
        source = Path("/etc") / public
        if source.exists():
            command += ["--ro-bind", str(source.resolve()), str(source)]
    if resolv is not None:
        command += ["--ro-bind", str(resolv), "/etc/resolv.conf"]
    command += ["--dev", "/dev", "--proc", "/proc", "--tmpfs", "/tmp", "--tmpfs", "/run", "--dir", "/home", "--dir", "/home/agent", "--dir", "/home/agent/.config", "--dir", "/home/agent/.cache", "--dir", "/home/agent/.local", "--dir", "/home/agent/.local/state", "--dir", "/home/agent/.local/share"]
    for grant in grants:
        command += ["--ro-bind", str(grant), str(grant)]
    # A read-only workspace is bound --ro-bind. Until this existed, a
    # provider declaring "workspace_mode": "read-only" got a fully
    # writable workspace and the restriction held only because the Codex
    # adapter volunteered --sandbox read-only in its own argv -- provider
    # code choosing its own restraint, which is what a sandbox boundary
    # exists in order not to depend on. /tmp stays a writable tmpfs, so a
    # read-only task still has scratch space.
    bind = "--ro-bind" if args.workspace_mode == "read-only" else "--bind"
    command += [bind, str(ws), str(ws), "--chdir", str(ws)]
    # Masks go on AFTER the workspace, so they overlay it. A path that resolved
    # outside the workspace is refused rather than quietly masked: masking
    # something the sandbox could not see anyway is a claim with no content, and
    # masking an arbitrary host path on request is a denial-of-service primitive.
    for masked in mask_targets(args, ws):
        command += masked
    
    # 'none' unshares here and stays empty. 'allow' does NOT: run() has
    # already created, NAT'd and filtered a namespace, and bwrap INHERITS it --
    # unsharing again would hand the sandbox a fresh empty one and undo both the
    # connectivity and the allowlist. Either way the sandbox never has the
    # host's network, its loopback services or its abstract sockets.
    if net == "none":
        command += ["--unshare-net"]
    environment = {"HOME": "/home/agent", "USER": "agent", "LOGNAME": "agent", "PATH": SANDBOX_PATH, "LANG": "C.UTF-8", "XDG_CONFIG_HOME": "/home/agent/.config", "XDG_CACHE_HOME": "/home/agent/.cache", "XDG_STATE_HOME": "/home/agent/.local/state", "XDG_DATA_HOME": "/home/agent/.local/share", "SHADOWFETCH_FIREBREAK": sid, "SHADOWFETCH_FIREBREAK_WORKSPACE": ws.name, "TMPDIR": "/tmp", "PYTHONDONTWRITEBYTECODE": "1"}
    if getattr(args, "codex_account", False):
        if net != "allow":
            raise Error("A Codex account grant requires explicit cloud network access")
        locations = [Path("/usr/lib/shadowfetch/missions")]
        locations += [parent / "packages/shadowfetch-missions/data/usr/lib/shadowfetch/missions" for parent in Path(__file__).resolve().parents]
        module_dir = next((p for p in locations if (p / "sf_mission_account.py").is_file()), None)
        if module_dir is None:
            raise Error("Install Mission Control account support first")
        sys.path.insert(0, str(module_dir))
        from sf_mission_account import account_home, AccountError
        try:
            dedicated = account_home()
        except AccountError as exc:
            raise Error(str(exc)) from exc
        if not (dedicated / "auth.json").is_file():
            raise Error("Sign in with shadowfetch-mission-account login first")
        if dedicated == ws or dedicated in ws.parents or ws in dedicated.parents:
            raise Error("Mission account storage must not overlap the workspace")
        command += ["--bind", str(dedicated), "/home/agent/.codex"]
        environment["CODEX_HOME"] = "/home/agent/.codex"
    requested = set(args.credential_env)
    if args.keep_secrets:
        requested |= {name for name in CREDENTIALS if name in os.environ and name != "SSH_AUTH_SOCK"}
        print("Deprecated --keep-secrets: use one --credential-env NAME per intended provider", file=sys.stderr)
    if not requested <= CREDENTIALS - {"SSH_AUTH_SOCK"}:
        raise Error("Credential grant must name a supported provider environment variable")
    for name in requested:
        if name not in os.environ:
            raise Error("Granted credential variable is not set: " + name)
        environment[name] = os.environ[name]
    for name, value in environment.items():
        command += ["--setenv", name, value]
    command += ["--", *args.agent_command]
    return command, net, grants, sorted(requested | ({"codex-account"} if getattr(args, "codex_account", False) else set()))

def limits(args):
    def apply():
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        # Do not pin RLIMIT_AS to the RSS budget. Codex code-mode-host's V8
        # sandbox reserves ~1 TiB of virtual address space on first execute;
        # a 3072 MiB AS cap kills it with SIGTRAP. Physical memory stays
        # capped by the systemd scope MemoryMax below.
        resource.setrlimit(resource.RLIMIT_CPU, (args.cpu_seconds, args.cpu_seconds + 1))
        resource.setrlimit(resource.RLIMIT_NOFILE, (256, 256))
        resource.setrlimit(resource.RLIMIT_FSIZE, (8 * 1024**3, 8 * 1024**3))
    return apply

def user_service_env():
    env = dict(os.environ)
    runtime = Path("/run/user") / str(os.getuid())
    if (runtime / "bus").is_socket():
        env.setdefault("XDG_RUNTIME_DIR", str(runtime))
        env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=" + str(runtime / "bus"))
    return env


# The programs that build and police the sandbox's network. Absolute paths:
# these decide whether a sandbox is contained, and a helper found on PATH would
# let the caller choose what "contained" means.
BWRAP_PATHS = ("/usr/bin/bwrap", "/bin/bwrap")
UNSHARE_PATHS = ("/usr/bin/unshare", "/bin/unshare")
NFT_PATHS = ("/usr/sbin/nft", "/sbin/nft", "/usr/bin/nft")
EGRESS_DNS_TIMEOUT = 10


def trusted_program(candidates, what):
    for candidate in candidates:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise Error("no %s exists at any of %s, and the sandbox will not run "
                "without it rather than run unfiltered"
                % (what, " or ".join(candidates)))


def egress_addresses(hosts):
    """Resolve the declared allowlist to IPv4 literals, on the HOST.

    The filter is by address because that is what a packet carries. Resolving
    here rather than in the sandbox is deliberate: the sandbox never gets to
    choose what a name means. The cost is stated rather than hidden -- a host
    whose address set changes after this moment (a CDN, a failover) is no longer
    reachable until the next run, and a name that resolves to several addresses
    is pinned to the ones seen now.
    """
    resolved = {}
    for host in hosts:
        try:
            infos = socket.getaddrinfo(host, 443, socket.AF_INET, socket.SOCK_STREAM)
        except OSError as exc:
            raise Error("cannot resolve the declared egress host %s: %s. The "
                        "sandbox is not started with an allowlist that could not "
                        "be turned into addresses" % (redact(host), redact(exc)))
        resolved[host] = sorted({info[4][0] for info in infos})
    return resolved


def egress_ruleset(addresses):
    """The nftables policy the sandbox runs under.

    Default drop. The slirp subnet is allowed because that is the NAT itself --
    the gateway and its DNS -- and without it nothing resolves or routes. Every
    other destination must be an address the allowlist named.
    """
    lines = ["table inet sfegress {",
             "  chain output {",
             "    type filter hook output priority 0; policy drop;",
             "    ct state established,related counter accept",
             '    oif "lo" counter accept',
             "    ip daddr 10.0.2.0/24 counter accept"]
    for host, ips in sorted(addresses.items()):
        for ip in ips:
            lines.append("    ip daddr %s counter accept" % ip)
    lines += ["    counter drop", "  }", "}"]
    return "\n".join(lines) + "\n"


# The helper that owns the namespace. It runs INSIDE a fresh user+net namespace,
# so it holds CAP_NET_ADMIN there and can install the filter without anybody
# reaching in from outside -- which is the step that could not be made to work
# when bwrap owned the namespace.
EGRESS_HELPER = r"""
import os, subprocess, sys
pid_path, ready_path, nft_bin, rules = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
with open(pid_path, "w") as handle:
    handle.write(str(os.getpid()))
# Block until the NAT has been attached from outside. A payload that ran before
# this point would run on an unconfigured interface.
with open(ready_path) as handle:
    handle.read(1)
subprocess.run(["/usr/sbin/ip", "link", "set", "lo", "up"],
               check=False, capture_output=True)
if rules:
    done = subprocess.run([nft_bin, "-f", "-"], input=rules,
                          text=True, capture_output=True)
    if done.returncode != 0:
        sys.stderr.write("firebreak: the egress allowlist did not install: "
                         + done.stderr[-300:])
        raise SystemExit(70)
os.execv(sys.argv[5], sys.argv[5:])
"""


# The user-space NAT that gives an isolated namespace outbound connectivity.
# Absolute paths: this decides whether a sandbox is contained, and a helper
# found on PATH would let the caller choose what "contained" means.
SLIRP_PATHS = ("/usr/bin/slirp4netns", "/bin/slirp4netns")
SLIRP_READY_TIMEOUT = 20


def slirp_binary():
    for candidate in SLIRP_PATHS:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def attach_network(child_pid, ready_w):
    """NAT the sandbox's namespace to the outside, and only to the outside.

    --disable-host-loopback is the point of the exercise: without it the NAT
    gateway forwards to the host's 127.0.0.1 and the namespace buys nothing.
    """
    binary = slirp_binary()
    if binary is None:
        raise Error(
            "network access was requested but no slirp4netns exists at "
            + " or ".join(SLIRP_PATHS)
            + ". Firebreak will not fall back to sharing the host network: "
            "that is the containment this session asked for")
    return subprocess.Popen(
        [binary, "--configure", "--mtu=65520", "--disable-host-loopback",
         "--ready-fd", str(ready_w), str(child_pid), "tap0"],
        pass_fds=(ready_w,), stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE, text=True)


def terminate_nat(nat):
    """The NAT dies with the session. It holds the sandbox namespace open, so
    leaving it running would leave a namespace and a helper behind per run."""
    if nat is None or nat.poll() is not None:
        return
    nat.terminate()
    try:
        nat.wait(timeout=5)
    except subprocess.TimeoutExpired:
        nat.kill()
        nat.wait(timeout=5)


# What a mask actually is, per kind of thing being masked. bwrap has no
# --mask-path -- which is what Firebreak's old comment meant -- but it does not
# need one: an empty tmpfs hides a directory's contents and /dev/null over a
# file makes every read return EOF. Both are mounts in the sandbox's own mount
# namespace, so no cooperation from the payload is involved.
def mask_targets(args, ws):
    """The bwrap arguments that hide each declared path. Refuses paths outside
    the workspace.

    Returns a list of argument lists so the caller can extend argv in order.
    """
    out = []
    for raw in (getattr(args, "mask_path", None) or []):
        candidate = Path(raw)
        if not candidate.is_absolute():
            raise Error("A masked path must be absolute: " + redact(str(raw)))
        # Resolved so a symlink cannot nominate a different target. The mount
        # lands INSIDE the sandbox's own mount namespace, so it changes nothing
        # on the host -- an earlier draft refused any path outside the workspace
        # on the theory that it was a way to break the host, which was simply
        # wrong, and would have refused every run of the shipped codex manifest,
        # whose masks are /home/agent/.ssh and /etc/shadow.
        resolved = Path(os.path.realpath(str(candidate)))
        if resolved.is_dir():
            # An empty tmpfs: the directory exists and is empty, which is what a
            # build expecting the directory to be present needs.
            out.append(["--tmpfs", str(resolved)])
        else:
            # /dev/null over the file: it opens, and reads return nothing.
            # Also the right answer for a path that does not exist on the host --
            # bwrap creates the mount point, so the sandbox sees an empty file
            # where the payload expected a secret.
            out.append(["--ro-bind", "/dev/null", str(resolved)])
    return out


def run(args):
    """Cleanup wrapper.

    The networked posture needs a scratch directory before the argv exists --
    the resolver file is bound BY the argv -- and it holds the namespace pid
    file and the release FIFO as well. It must not survive any exit path,
    including the ones that refuse before a sandbox is ever built, so the
    directory is owned here and the work happens below.
    """
    holder = {"scratch": None}
    try:
        return _run(args, holder)
    finally:
        if holder["scratch"]:
            shutil.rmtree(holder["scratch"], ignore_errors=True)


def _run(args, holder):
    if args.agent_command and args.agent_command[0] == "--":
        args.agent_command.pop(0)
    if not args.agent_command:
        raise Error("No agent command; place it after --")
    if not trusted_which("bwrap"):
        raise Error("bubblewrap is not installed")
    if not 256 <= args.memory_mb <= 65536 or not 1 <= args.cpu_seconds <= 86400 or not 8 <= args.processes <= 1024:
        raise Error("Invalid memory, CPU time or process limit")
    ws = workspace(args.workspace)
    sid = session_id(getattr(args, "session_id", None))
    resolv = None
    if effective_network(args) == "allow":
        holder["scratch"] = tempfile.mkdtemp(prefix="sf-egress-")
        resolv = os.path.join(holder["scratch"], "resolv.conf")
        with open(resolv, "w", encoding="utf-8") as handle:
            handle.write(SLIRP_RESOLV_CONF)
        os.chmod(resolv, 0o644)
    cmd, net, grants, credentials = arguments(args, ws, sid, resolv=resolv)
    # The values behind the granted identities, so the record can strike them
    # from an argv by EQUALITY. Held only for the length of building the record
    # and never written anywhere; arguments() read them from this same
    # environment a moment ago.
    granted_values = tuple(os.environ[name] for name in credentials
                           if name in os.environ)
    if not trusted_which("systemd-run"):
        raise Error("systemd-run is required for per-session CPU, memory and process limits")
    # RLIMIT_NPROC counts all threads for the desktop UID, including unrelated
    # applications. A dedicated cgroup enforces this session's actual task cap.
    cmd = ["systemd-run", "--user", "--scope", "--quiet", "--collect", "--unit=" + sid, "--description=Shadowfetch Firebreak isolated task", "--property=TasksMax=" + str(args.processes), "--property=MemoryMax=" + str(args.memory_mb) + "M", "--property=MemorySwapMax=0", "--property=CPUQuota=200%", "--", *cmd]
    checkpoint = None
    if not args.no_checkpoint:
        # --json: the recovery id comes back as a value. Splitting the human
        # sentence made the wording of that sentence the recovery contract, and
        # silently truncated any id containing a character outside [0-9-].
        result = subprocess.run([checkpoint_bin(), "snapshot", ws.name, "--label", "firebreak:" + sid, "--json"], capture_output=True, text=True, timeout=600)
        if result.returncode:
            raise Error("Checkpoint failed; execution refused: " + result.stderr[-500:])
        try:
            receipt = json.loads(result.stdout)
            checkpoint = receipt["id"]
        except (ValueError, TypeError, KeyError):
            raise Error("Checkpoint engine returned an invalid receipt; execution refused")
        if not isinstance(checkpoint, str) or not checkpoint.strip():
            raise Error("Checkpoint engine returned an invalid receipt; execution refused")
        print("checkpoint " + checkpoint + " taken", flush=True)
    started = datetime.datetime.now(datetime.timezone.utc).isoformat()
    # The session id belongs to the caller and may be reused between runs; the
    # run id is minted here so a started record and an ended record still pair
    # up unambiguously when it is.
    run_id = uuid.uuid4().hex
    directory = state()
    record = directory / (sid + ".session")
    # THE RECORDED ARGV HAS TO BE THE ARGV THAT RUNS. Posture 'allow' wraps the
    # sandbox in a helper that owns the network namespace and installs the
    # egress filter, so a record built from the bwrap argv alone would omit both
    # mechanisms doing the containment -- and enforcement(), which reads the
    # argv rather than the request, would report a namespace nobody created.
    # Built here, recorded, and spawned unchanged.
    scratch = holder["scratch"]
    ready_path = None
    launch = list(cmd)
    if net == "allow":
        try:
            pid_path = os.path.join(scratch, "ns.pid")
            ready_path = os.path.join(scratch, "ready")
            os.mkfifo(ready_path)
            addresses = egress_addresses(args.egress_host or [])
            rules = egress_ruleset(addresses) if addresses else ""
            marker = launch.index("--") + 1
            # systemd-run wraps the WHOLE tree, so the cgroup limits still cover
            # the helper, the sandbox and everything they start.
            launch[marker:marker] = [
                trusted_program(UNSHARE_PATHS, "unshare"),
                "--user", "--map-root-user", "--net", "--fork",
                "/usr/bin/python3", "-c", EGRESS_HELPER,
                pid_path, ready_path,
                trusted_program(NFT_PATHS, "nft"), rules]
        except BaseException as exc:
            # A REFUSAL IS A DECISION, AND IT IS THE ONE WORTH KEEPING. Building
            # this argv can refuse -- an egress host that resolves to no address
            # is refused rather than run unfiltered -- and because the started
            # record is written after it, that decision left no trace whatsoever:
            # the audit directory showed no session, as though nobody had asked.
            # One line, with what is known at this point.
            try:
                append_record(record, {
                    "record": "refused", "schema": RECORD_SCHEMA,
                    "firebreak": VERSION, "at": started, "started": started,
                    "session": sid, "run": run_id,
                    "mission": getattr(args, "mission", None),
                    "task": getattr(args, "task", None),
                    "workspace": str(ws),
                    "network_requested": args.net,
                    "network_effective": net,
                    "egress_allowlist_requested": [
                        redact(str(host)) for host in
                        (getattr(args, "egress_host", None) or [])],
                    "refused_before": "sandbox-launch",
                    "reason": redact(exc)})
            except OSError as write_failure:
                print("Firebreak: the refusal of session " + sid
                      + " was not recorded: " + redact(write_failure),
                      file=sys.stderr)
            raise
    program = args.agent_command[0] if args.agent_command else ""
    resolved, resolution = resolved_executable(program, ws)
    manifest = {"record": "started",
                "schema": RECORD_SCHEMA,
                "firebreak": VERSION,
                "at": started,
                "started": started,
                "session": sid,
                "run": run_id,
                "session_id_source": ("orchestrator" if getattr(args, "session_id", None)
                                      else "firebreak"),
                "mission": getattr(args, "mission", None),
                "task": getattr(args, "task", None),
                "scope_unit": sid + ".scope",
                "pid": os.getpid(),
                "parent_pid": os.getppid(),
                "parent_command": parent_command(),
                "audit_directory": str(directory),
                "audit_directory_relocated": state_relocated(),
                "workspace": str(ws),
                "workspace_mode_requested": args.workspace_mode,
                "executable": redact(program),
                "executable_resolved": resolved,
                "executable_resolution": resolution,
                # The resolved values are handed in so a secret appearing in
                # the caller's own argv -- mytool --api-key VALUE -- is struck by
                # equality, not merely by shape. The text redactor cannot
                # recognise a short or arbitrary value, and this file outlives
                # the process.
                "agent_command": redacted_argv(args.agent_command,
                                               values=granted_values),
                "sandbox_argv": redacted_argv(launch, values=granted_values),
                "network_requested": args.net,
                "network_effective": net,
                # Redacted like everything else: a host can carry credentials
                # in its userinfo (user:PASSWORD@host) and a path can be under a
                # directory whose name is a token.
                "egress_allowlist_requested": [redact(str(host)) for host in
                                               (getattr(args, "egress_host", None) or [])],
                "masked_paths_requested": [redact(str(path)) for path in
                                           (getattr(args, "mask_path", None) or [])],
                "read_grants": [redact(str(grant)) for grant in grants],
                # What was ASKED for, including the --keep-secrets expansion.
                # Recording only the explicit flag showed "nothing requested"
                # while identities were granted, which reads as a contradiction
                # to anyone auditing the pair.
                "credentials_requested": sorted(set(credentials)
                                                | set(args.credential_env)),
                # Identities. A credential VALUE has never reached this file and
                # must not; see redacted_argv().
                "credential_names": credentials,
                "checkpoint": checkpoint,
                "checkpoint_requested": not args.no_checkpoint,
                "limits_requested": {"memory_mb": args.memory_mb,
                                     "cpu_seconds": args.cpu_seconds,
                                     "processes": args.processes},
                "enforcement": enforcement(launch, args, ws, grants, credentials, net)}
    # Before the sandbox is spawned, not after: a session that cannot be
    # recorded is not executed.
    try:
        append_record(record, manifest)
    except BaseException:
        if scratch:
            shutil.rmtree(scratch, ignore_errors=True)
        raise
    process = None
    rc = None
    reason = "not-started"
    def terminate(signum, frame):
        if process and process.poll() is None:
            process.terminate()
        raise KeyboardInterrupt
    previous = signal.signal(signal.SIGTERM, terminate)
    try:
        try:
            nat = None
            if net == "allow":
                # THE NAMESPACE IS OURS FROM THE FIRST INSTANT. bwrap used to
                # create it, and reaching into bwrap's namespace could not be
                # made to work: joining it stopped slirp4netns attaching
                # afterwards, and attaching first made it unjoinable. Both
                # directions were measured -- see STAGE_C_FINDINGS.md.
                #
                # So a helper unshares user+net, slirp attaches the NAT to that
                # namespace from outside, the helper installs the allowlist
                # ITSELF (it holds CAP_NET_ADMIN over the namespace it just
                # created, so no nsenter is needed at all), and it finally execs
                # bwrap WITHOUT --unshare-net. The sandbox inherits a namespace
                # that is already NAT'd and already filtered. The argv for all
                # of that was built and recorded above, and is spawned as-is.
                process = subprocess.Popen(launch, preexec_fn=limits(args),
                                           env=user_service_env())
                nat = None
                try:
                    deadline = time.monotonic() + 20
                    ns_pid = None
                    pid_file = os.path.join(scratch, "ns.pid")
                    while time.monotonic() < deadline:
                        try:
                            with open(pid_file) as handle:
                                text = handle.read().strip()
                        except OSError:
                            text = ""
                        if text.isdigit():
                            ns_pid = int(text)
                            break
                        if process.poll() is not None:
                            break
                        time.sleep(0.05)
                    if ns_pid is None:
                        raise Error(
                            "the network namespace helper never reported itself, "
                            "so no NAT could be attached and execution is refused "
                            "rather than run unfiltered")
                    ready_r, ready_w = os.pipe()
                    nat = attach_network(ns_pid, ready_w)
                    os.close(ready_w)
                    with os.fdopen(ready_r, "rb") as handle:
                        if not handle.read(1):
                            raise Error(
                                "the network helper exited before the sandbox "
                                "interface came up: "
                                + (nat.stderr.read() if nat.stderr else "")[-300:])
                    with open(ready_path, "w") as handle:
                        handle.write("go")     # release the helper
                    rc = process.wait()
                finally:
                    terminate_nat(nat)
                    shutil.rmtree(scratch, ignore_errors=True)
            else:
                process = subprocess.Popen(cmd, preexec_fn=limits(args),
                                           env=user_service_env())
                rc = process.wait()
            reason = ("signal:" + signal_name(-rc) if rc < 0
                      else "completed" if rc == 0 else "nonzero-exit")
        except KeyboardInterrupt:
            rc, reason = 130, "cancelled"
            if process and process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
    finally:
        signal.signal(signal.SIGTERM, previous)
        try:
            append_record(record, {"record": "ended", "schema": RECORD_SCHEMA,
                                   "at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                                   "started": started,
                                   "session": sid, "run": run_id,
                                   "mission": getattr(args, "mission", None),
                                   "task": getattr(args, "task", None),
                                   "exit": rc, "exit_reason": reason,
                                   "checkpoint": checkpoint})
        except OSError as exc:
            # Said out loud rather than swallowed, and never in place of the
            # exception already on its way out of this block.
            print("Firebreak: the end of session " + sid + " was not recorded: "
                  + redact(exc), file=sys.stderr)
    print(f"Firebreak session {sid} ended (exit {rc})", file=sys.stderr)
    if checkpoint:
        print(f"Undo: shadowfetch-checkpoint undo {ws.name} {checkpoint}", file=sys.stderr)
    return rc if rc >= 0 else 128 - rc

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version="shadowfetch-firebreak (Shadowfetch Linux) " + VERSION)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("check")
    log = sub.add_parser("log")
    log.add_argument("count", nargs="?", type=int, default=10)
    execute = sub.add_parser("run")
    execute.add_argument("--session-id", default=None,
                         help="Correlation id issued by the orchestrator; one identity "
                              "across Mission Control, this sandbox and the audit log")
    execute.add_argument("--mission", default=None,
                         help="Mission this session belongs to, recorded for audit")
    execute.add_argument("--task", default=None,
                         help="Task within the mission, recorded for audit")
    execute.add_argument("--workspace", default="")
    execute.add_argument("--net", choices=("none", "allow"))
    execute.add_argument("--read", action="append", default=[], metavar="ABSOLUTE_PATH")
    execute.add_argument("--codex-account", action="store_true", help="Grant the dedicated Mission Control account for an approved cloud task")
    execute.add_argument("--credential-env", action="append", default=[], metavar="NAME")
    execute.add_argument("--egress-host", action="append", default=[], metavar="HOST",
                         help="Destination the sandbox may reach under --net allow. "
                              "Resolved to addresses on the host at launch and installed "
                              "as a default-DROP nftables ruleset in the sandbox's own "
                              "network namespace, before the payload starts. Filtering is "
                              "BY ADDRESS: a name whose address set changes afterwards is "
                              "unreachable until the next run. Under --net none there is "
                              "no route to filter and the record says so")
    execute.add_argument("--mask-path", action="append", default=[], metavar="ABSOLUTE_PATH",
                         help="Path inside the workspace to hide from the sandbox. A "
                              "directory becomes an empty tmpfs, a file becomes "
                              "/dev/null. Enforced by the mount namespace, not by the "
                              "payload's cooperation. A path outside the workspace is "
                              "refused. Masking is by path: a hardlink to the same "
                              "inode under an unmasked name is still readable")
    execute.add_argument("--keep-secrets", action="store_true", help="Deprecated explicit provider credential pass-through")
    execute.add_argument("--no-checkpoint", action="store_true", help="For callers that already own a recovery checkpoint")
    execute.add_argument("--workspace-mode", choices=("workspace-write", "read-only"), default="workspace-write")
    execute.add_argument("--memory-mb", type=int, default=4096)
    execute.add_argument("--cpu-seconds", type=int, default=900)
    execute.add_argument("--processes", type=int, default=128)
    execute.add_argument("agent_command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    try:
        if args.command == "run":
            return run(args)
        if args.command == "log":
            directory = state()
            if state_relocated():
                print("Firebreak: reading relocated audit state at " + str(directory), file=sys.stderr)
            for file in sorted(directory.glob("*.session"), key=lambda p:p.stat().st_mtime, reverse=True)[:max(0, min(args.count, 100))]:
                for entry in read_records(file):
                    print(json.dumps(entry, indent=2, sort_keys=True))
            return 0
        if args.command == "check":
            bwrap = trusted_which("bwrap")
            if not bwrap:
                raise Error("bubblewrap is missing")
            probe = subprocess.run([bwrap, "--ro-bind", "/usr", "/usr", "--symlink", "usr/bin", "/bin", "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64", "--unshare-user", "--unshare-pid", "--proc", "/proc", "--", "/usr/bin/true"], capture_output=True, text=True, timeout=10)
            if probe.returncode:
                raise Error("Sandbox namespaces cannot start: " + probe.stderr.strip())
            if not Path(checkpoint_bin()).exists() and not trusted_which(checkpoint_bin()):
                raise Error("Checkpoint engine is missing")
            print("Firebreak ready: namespaces execute, private home, explicit read grants, recovery available")
            return 0
        parser.print_help()
        return 0
    except (Error, OSError, subprocess.TimeoutExpired) as exc:
        print("Firebreak: " + redact(exc), file=sys.stderr)
        return 1

if __name__ == "__main__":
    raise SystemExit(main())
