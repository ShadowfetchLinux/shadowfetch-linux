<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Shadowfetch Project</vendor>
  <vendor_url>https://www.shadowfetchlinux.org/</vendor_url>
  <action id="org.shadowfetch.fireline.check">
    <description>Check Fireline sandbox readiness</description>
    <message>Authentication is required to check agent-sandbox kernel settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/shadowfetch-firebreak</annotate>
  </action>
</policyconfig>
