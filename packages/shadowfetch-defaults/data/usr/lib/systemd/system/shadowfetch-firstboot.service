[Unit]
Description=Shadowfetch first-boot setup (Flathub remote, firewall, NVIDIA power)
# 2.1.2: do not run on a live session.
#
# The only guard used to be firstboot.done, so booting the USB to look at the
# distro ran the whole script on the visitor's machine: it set the hardware clock
# to local time (firstboot.sh:24) and downloaded Flatpak themes before the
# firewall came up. Neither is acceptable on a machine nobody installed onto.
# Same guard hook 0020 already uses for the GPU unit.
ConditionPathExists=!/var/lib/shadowfetch/firstboot.done
ConditionPathExists=!/run/live/medium
ConditionPathExists=!/run/live/rootfs
After=local-fs.target
# 4.0.0: Phoenix owns the Btrfs snapshot layout. The snapper block that used to
# live in firstboot.sh raced phoenix-firstboot and could leave /.snapshots half
# initialised, so it was removed; this ordering keeps any future first-boot step
# behind Phoenix. Ordering only - NOT Requires=: a Phoenix failure must never
# stop the Flathub remote, the firewall or the RTC/timesync setup below.
After=phoenix-firstboot.service

[Service]
Type=oneshot
ExecStart=/usr/lib/shadowfetch/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
