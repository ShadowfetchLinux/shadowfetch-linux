#!/bin/bash
# Verified setup and launcher for official Buzz Desktop and its private relay.
set -euo pipefail

BUZZ_VERSION="0.5.17"
BUZZ_IMAGE="ghcr.io/block/buzz@sha256:4e31b7c7abb7d00b6f513dc559e58d2b980416f1dc400aa01bcf762cf2989cfc"
RELAY_URL="ws://127.0.0.1:3000"
RELAY_HTTP="http://127.0.0.1:3000"
COMPUTE_HTTP="http://127.0.0.1:9337"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shadowfetch/buzz"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/shadowfetch/buzz"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch/buzz"
COMPOSE_SOURCE="${SHADOWFETCH_BUZZ_COMPOSE_SOURCE:-/usr/share/shadowfetch/buzz/compose.yml}"
OWNER_BOOTSTRAP="/usr/libexec/shadowfetch-buzz-bootstrap"

say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m OK\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m !!\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
shadowfetch-buzz - Install and run Buzz with a private local relay.

USAGE
  shadowfetch-buzz setup [--yes] [--no-open]
  shadowfetch-buzz doctor
  shadowfetch-buzz open
  shadowfetch-buzz status
  shadowfetch-buzz stop

Setup verifies the official Buzz package, rootless container stack, disk space,
ports, secret permissions and relay readiness. Buzz itself recommends and
downloads open-source models from Settings > Compute only after confirmation.
EOF
}

version() {
    printf 'shadowfetch-buzz (Shadowfetch Linux %s; Buzz %s)\n' \
        "$(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)" "$BUZZ_VERSION"
}

as_root() {
    if (( EUID == 0 )); then
        "$@"
    elif [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v pkexec >/dev/null 2>&1; then
        pkexec "$@"
    else
        sudo "$@"
    fi
}

random_hex() {
    local bytes=${1:-32}
    od -An -N"$bytes" -tx1 /dev/urandom | tr -d ' \n'
}

port_in_use() {
    local port=$1
    ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)$port$"
}

ensure_user_service_bus() {
    local runtime_dir
    runtime_dir="/run/user/$(id -u)"

    # Graphical launches already have these. A terminal/SSH launch for the
    # logged-in desktop user needs the same user-manager endpoint explicitly.
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "$runtime_dir" ]]; then
        export XDG_RUNTIME_DIR="$runtime_dir"
    fi
    if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
    fi
    [[ -n "${XDG_RUNTIME_DIR:-}" && -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]
}

prepare_buzz_rendering() {
    # WebKitGTK's DMA-BUF renderer can freeze Buzz on Plasma Wayland. Prefer
    # the current shared-memory fallback while preserving explicit overrides.
    if [[ -n "${WAYLAND_DISPLAY:-}" \
        && -z "${WEBKIT_DMABUF_RENDERER_FORCE_SHM+x}" \
        && -z "${WEBKIT_DISABLE_DMABUF_RENDERER+x}" ]]; then
        export WEBKIT_DMABUF_RENDERER_FORCE_SHM=1
    fi
}

relay_ready() {
    curl -fsS --max-time 2 "$RELAY_HTTP/_readiness" >/dev/null 2>&1
}

compute_ready() {
    curl -fsS --max-time 2 "$COMPUTE_HTTP/v1/models" >/dev/null 2>&1
}

preflight() {
    local available port_state="available" compute_state="available"
    [[ $(uname -m) == "x86_64" ]] || {
        warn "Shadowfetch Fire Edition 3.0.0 supports x86_64 systems only."
        return 1
    }
    for command in podman podman-compose curl ss flock; do
        command -v "$command" >/dev/null 2>&1 || {
            warn "$command is missing. Repair the base installation before Buzz setup."
            return 1
        }
    done
    [[ -r "$COMPOSE_SOURCE" ]] || { warn "The Buzz compose definition is missing."; return 1; }
    podman info >/dev/null 2>&1 || {
        warn "Rootless Podman is not healthy for this user."
        return 1
    }
    if port_in_use 3000 && ! relay_ready; then
        warn "Port 3000 is already used by another application."
        return 1
    fi
    if port_in_use 9337 && ! compute_ready; then
        warn "Port 9337 is occupied, so Buzz shared compute cannot start."
        return 1
    fi
    relay_ready && port_state="already serving a healthy Buzz relay"
    compute_ready && compute_state="already serving Buzz shared compute"
    available=$(df -PB1 "$HOME" | awk 'NR == 2 {print $4}')
    [[ "$available" =~ ^[0-9]+$ ]] || { warn "Could not measure free disk space."; return 1; }
    if (( available < 8 * 1024 * 1024 * 1024 )); then
        warn "Buzz setup needs at least 8 GiB free before optional model downloads."
        return 1
    fi
    printf 'Preflight passed: rootless Podman healthy, relay port %s, compute port %s, %.1f GiB free.\n' \
        "$port_state" "$compute_state" "$((available / 1024 / 1024))e-3"
}

set_env_value() {
    local file=$1 key=$2 value=$3 escaped
    escaped=${value//&/\\&}
    if grep -q "^${key}=" "$file" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${escaped}|" "$file"
    else
        printf '%s=%s\n' "$key" "$value" >> "$file"
    fi
}

ensure_secret() {
    local file=$1 key=$2 bytes=$3 chars
    chars=$((bytes * 2))
    if ! grep -Eq "^${key}=[0-9a-f]{${chars}}$" "$file" 2>/dev/null; then
        set_env_value "$file" "$key" "$(random_hex "$bytes")"
    fi
}

write_config() {
    local env_file="$DATA_DIR/.env"
    umask 077
    install -d -m 0700 "$CONFIG_DIR" "$DATA_DIR"
    install -m 0644 "$COMPOSE_SOURCE" "$DATA_DIR/compose.yml"
    [[ -e "$env_file" ]] || : > "$env_file"

    set_env_value "$env_file" BUZZ_IMAGE "$BUZZ_IMAGE"
    set_env_value "$env_file" RELAY_URL "$RELAY_URL"
    set_env_value "$env_file" BUZZ_MEDIA_BASE_URL "http://127.0.0.1:3000/media"
    set_env_value "$env_file" BUZZ_MEDIA_SERVER_DOMAIN "127.0.0.1:3000"
    set_env_value "$env_file" BUZZ_CORS_ORIGINS "tauri://localhost,http://tauri.localhost,http://127.0.0.1:3000"
    set_env_value "$env_file" BUZZ_REQUIRE_AUTH_TOKEN false
    set_env_value "$env_file" BUZZ_REQUIRE_RELAY_MEMBERSHIP false
    set_env_value "$env_file" BUZZ_ALLOW_NIP_OA_AUTH true
    set_env_value "$env_file" BUZZ_AUTO_MIGRATE true
    set_env_value "$env_file" BUZZ_GIT_CONFORMANCE_PROBE true
    set_env_value "$env_file" POSTGRES_DB buzz
    set_env_value "$env_file" POSTGRES_USER buzz
    set_env_value "$env_file" BUZZ_S3_BUCKET buzz-media
    set_env_value "$env_file" BUZZ_HTTP_PORT 3000
    ensure_secret "$env_file" BUZZ_RELAY_PRIVATE_KEY 32
    ensure_secret "$env_file" BUZZ_GIT_HOOK_HMAC_SECRET 32
    ensure_secret "$env_file" POSTGRES_PASSWORD 32
    ensure_secret "$env_file" REDIS_PASSWORD 32
    ensure_secret "$env_file" BUZZ_S3_ACCESS_KEY 12
    ensure_secret "$env_file" BUZZ_S3_SECRET_KEY 32
    chmod 0600 "$env_file"

    printf 'BUZZ_RELAY_URL=%s\n' "$RELAY_URL" > "$CONFIG_DIR/client.env"
    chmod 0600 "$CONFIG_DIR/client.env"
}

start_relay() {
    if port_in_use 3000 && ! relay_ready; then
        warn "Port 3000 became occupied before Buzz could start."
        return 1
    fi
    say "Starting the private Buzz relay..."
    if ! ensure_user_service_bus; then
        warn "Could not reach your user service manager. Sign in to the desktop, then run setup again."
        return 1
    fi
    if ! systemctl --user daemon-reload; then
        warn "The user service manager could not reload the Buzz service."
        return 1
    fi
    if ! systemctl --user enable shadowfetch-buzz.service >/dev/null; then
        warn "The Buzz relay service could not be enabled for this user."
        return 1
    fi
    if ! systemctl --user restart shadowfetch-buzz.service; then
        warn "The Buzz relay service could not be started."
        systemctl --user --no-pager status shadowfetch-buzz.service || true
        journalctl --user -u shadowfetch-buzz.service -n 120 --no-pager || true
        return 1
    fi
    for _ in $(seq 1 90); do
        if relay_ready; then
            ok "Buzz relay is ready on 127.0.0.1:3000 only."
            return 0
        fi
        sleep 2
    done
    warn "Buzz relay did not become ready."
    systemctl --user --no-pager status shadowfetch-buzz.service || true
    journalctl --user -u shadowfetch-buzz.service -n 120 --no-pager || true
    return 1
}

prepare_first_owner() {
    local copied=0
    umask 077
    install -d -m 0700 "$STATE_DIR"

    if [[ ! -e "$STATE_DIR/local-owner-enrolled" ]]; then
        if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null 2>&1; then
            if printf '%s' "$RELAY_URL" | timeout 5 wl-copy --paste-once; then
                copied=1
            fi
        elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null 2>&1; then
            if printf '%s' "$RELAY_URL" | timeout 5 xclip -selection clipboard; then
                copied=1
            fi
        fi
        if ((copied)); then
            command -v notify-send >/dev/null 2>&1 && notify-send \
                --app-name="Shadowfetch Buzz" \
                "Buzz local relay copied" \
                "Paste the address when Buzz asks you to join a community." \
                >/dev/null 2>&1 || true
            ok "Buzz local relay address copied to the clipboard."
        fi
    fi

    [[ -x "$OWNER_BOOTSTRAP" ]] || {
        warn "The Buzz local-owner helper is missing; repair shadowfetch-defaults."
        return 1
    }
    "$OWNER_BOOTSTRAP" >>"$STATE_DIR/owner-bootstrap.log" 2>&1 8>&- &
}

cmd_setup() {
    local assume_yes=0 open_after=1 lock_dir
    shift || true
    while (($#)); do
        case "$1" in
            --yes|-y) assume_yes=1; shift ;;
            --no-open) open_after=0; shift ;;
            -h|--help) usage; exit 0 ;;
            *) warn "Unknown setup option: $1"; exit 2 ;;
        esac
    done

    lock_dir=${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch}
    install -d -m 0700 "$lock_dir"
    exec 8>"$lock_dir/shadowfetch-buzz-setup.lock"
    flock -n 8 || { warn "Another Buzz setup is already running."; exit 3; }
    preflight

    echo "Shadowfetch will install official Buzz Desktop ${BUZZ_VERSION} and create"
    echo "a loopback-only relay. Buzz will recommend an open-source model inside"
    echo "Settings > Compute and will not download it until you confirm."
    if (( ! assume_yes )); then
        read -r -p "Continue? [Y/n] " answer
        [[ ! "$answer" =~ ^[Nn]$ ]] || exit 0
    fi

    as_root /usr/libexec/shadowfetch-buzz-provision
    write_config
    start_relay
    ok "Buzz Desktop and its private relay passed setup checks."

    if (( open_after )); then
        flock -u 8
        exec 8>&-
        cmd_open
    fi
    return 0
}

cmd_doctor() {
    version
    preflight
    for file in "$CONFIG_DIR/client.env" "$DATA_DIR/.env"; do
        [[ ! -e "$file" || $(stat -c '%a' "$file" 2>/dev/null) == 600 ]] || {
            warn "Buzz configuration permissions are not 600: $file"
            return 1
        }
    done
    ok "Read-only Buzz preflight passed."
}

cmd_open() {
    command -v buzz-desktop >/dev/null 2>&1 || {
        warn "Buzz Desktop is not installed. Run: shadowfetch-buzz setup"
        exit 1
    }
    if ! relay_ready; then
        [[ -s "$DATA_DIR/.env" ]] || { warn "Run shadowfetch-buzz setup first."; exit 1; }
        start_relay
    fi
    prepare_first_owner
    export BUZZ_RELAY_URL="$RELAY_URL"
    prepare_buzz_rendering
    exec buzz-desktop
}

cmd_status() {
    version
    if command -v buzz-desktop >/dev/null 2>&1; then ok "Buzz Desktop is installed."; else warn "Buzz Desktop is not installed."; fi
    if relay_ready; then ok "Relay ready at $RELAY_URL (loopback only)."; else warn "Relay is not ready."; fi
    if [[ -r "$DATA_DIR/.env" ]] && grep -Fxq "BUZZ_IMAGE=$BUZZ_IMAGE" "$DATA_DIR/.env"; then
        ok "Relay image matches the 3.0.0 release pin."
    elif [[ -e "$DATA_DIR/.env" ]]; then
        warn "Relay configuration is older than the 3.0.0 image pin; rerun setup."
    fi
    if compute_ready; then
        ok "Buzz shared compute is active on 127.0.0.1:9337."
    else
        printf ' -- Buzz shared compute is off; Buzz manages model downloads.\n'
    fi
}

cmd_stop() {
    systemctl --user stop shadowfetch-buzz.service >/dev/null 2>&1 || true
    ok "Buzz relay stopped; data and secrets were preserved."
}

case "${1:-open}" in
    -h|--help) usage ;;
    --version) version ;;
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor ;;
    open) cmd_open ;;
    status) cmd_status ;;
    stop) cmd_stop ;;
    *) usage >&2; exit 2 ;;
esac
