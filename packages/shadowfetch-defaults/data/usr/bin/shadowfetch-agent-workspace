#!/bin/bash
# Create and operate isolated, documented workspaces for project work.
set -euo pipefail

# ---- --help / --version, BEFORE any side effect -----------------------------
# This block is deliberately the first thing that runs. Until 2026-07-26 this
# tool had no argument handling at all, so `--help` fell through to the body and
# ran the tool's normal actions. Someone asking a command what it does
# should never thereby cause it to do the thing.
case "${1:-}" in
  -h|--help)
    cat <<'SFHELP'
shadowfetch-agent-workspace - Create and operate project workspaces.

USAGE
  shadowfetch-agent-workspace              open the workspace menu
  shadowfetch-agent-workspace create NAME  create one
  shadowfetch-agent-workspace list         list workspaces
  shadowfetch-agent-workspace open NAME    open a workspace folder

WHAT IT DOES
  Workspaces live under ~/Workspaces (override with
  SHADOWFETCH_AGENT_WORKSPACES). Each gets its own instructions, tasks
  and safety rules.

Part of Shadowfetch Linux. https://www.shadowfetchlinux.org/
SFHELP
    exit 0 ;;
  --version)
    echo "shadowfetch-agent-workspace (Shadowfetch Linux) $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)"; exit 0 ;;
esac

say() { printf '\n\033[1;33m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
die() { printf '  \033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }

(( EUID != 0 )) || die "Run this user workspace tool as your desktop account, not root."
requested_root="${SHADOWFETCH_AGENT_WORKSPACES:-$HOME/Workspaces}"
[[ -n "$requested_root" ]] || die "The workspace root cannot be empty."
ROOT=$(realpath -m -- "$requested_root") \
    || die "Could not resolve the workspace root: $requested_root"
[[ "$ROOT" != / ]] || die "The filesystem root cannot be used as a workspace."
mkdir -p -- "$ROOT"
chmod 700 -- "$ROOT"

sanitize() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//' | cut -c1-48
}

create_workspace() {
    local requested="${1:-}"
    [[ -n "$requested" ]] || read -r -p "Workspace name: " requested
    local name
    name=$(sanitize "$requested")
    [[ -n "$name" && "$name" != . && "$name" != .. ]] \
        || die "Use letters, numbers, dots, dashes or underscores."
    local workspace="$ROOT/$name"
    [[ ! -e "$workspace" && ! -L "$workspace" ]] || die "Workspace already exists: $workspace"
    mkdir -p "$workspace"/{artifacts,logs,scratch,skills}
    chmod 700 "$workspace"

    cat >"$workspace/AGENTS.md" <<EOF
# $requested

## Mission

Describe the outcome this workspace exists to produce.

## Operating rules

- Read this file and TASKS.md before acting.
- Keep work inside this workspace unless explicitly authorized.
- Never place passwords, API keys, tokens, private keys, or recovery codes in project files.
- Ask before publishing, purchasing, deleting, messaging, or changing external systems.
- Record durable decisions in MEMORY.md and completed work in JOURNAL.md.
- Run relevant checks before claiming a task is complete.

## Tools

Start with the least powerful tool that can safely complete the task. Prefer reversible changes and preserve user work.
EOF
    cat >"$workspace/TASKS.md" <<'EOF'
# Tasks

## Active

- [ ] Define the first concrete outcome.

## Waiting

## Completed
EOF
    cat >"$workspace/MEMORY.md" <<'EOF'
# Durable Memory

Store verified project facts and decisions here. Do not store secrets.
EOF
    cat >"$workspace/JOURNAL.md" <<'EOF'
# Work Journal

Record dated summaries of important work, checks, and remaining risks.
EOF
    cat >"$workspace/.env.example" <<'EOF'
# Variable names only. Never put real credentials in this file.
EOF
    cat >"$workspace/.gitignore" <<'EOF'
.env
*.key
*.pem
*.p12
*.p8
logs/
scratch/
EOF
    info "Created $workspace"
    info "Open it with: shadowfetch-agent-workspace open $name"
}

open_workspace() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "Usage: shadowfetch-agent-workspace open <name>"
    local safe workspace
    safe=$(sanitize "$name")
    [[ -n "$safe" && "$safe" != . && "$safe" != .. ]] \
        || die "Use letters, numbers, dots, dashes or underscores."
    workspace="$ROOT/$safe"
    [[ -d "$workspace" && ! -L "$workspace" ]] || die "Workspace not found: $workspace"
    if command -v dolphin >/dev/null 2>&1; then
        dolphin "$workspace" >/dev/null 2>&1 &
    else
        printf '%s\n' "$workspace"
    fi
}

menu() {
    say "Shadowfetch Workspaces"
    info "Workspaces keep instructions, task state, artifacts and memory together."
    printf '\n  1) Create workspace\n  2) List workspaces\n  3) Open workspace folder\n  q) Quit\n\n'
    read -r -p "Choose: " choice
    case "$choice" in
        1) create_workspace ;;
        2) find "$ROOT" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '  %f\n' | sort ;;
        3) read -r -p "Workspace name: " name; open_workspace "$name" ;;
        q|Q|"") exit 0 ;;
        *) die "Unknown choice." ;;
    esac
}

case "${1:-}" in
    create) create_workspace "${2:-}" ;;
    list) find "$ROOT" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort ;;
    open) open_workspace "${2:-}" ;;
    "") menu ;;
    *) die "Usage: shadowfetch-agent-workspace [create|list|open] [name]" ;;
esac
