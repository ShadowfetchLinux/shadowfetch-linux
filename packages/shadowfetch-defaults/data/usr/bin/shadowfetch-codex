#!/bin/bash
# Verified, user-owned installer and launcher for the official OpenAI Codex CLI.
set -euo pipefail

CODEX_VERSION="0.150.1"
INSTALLER_URL="https://chatgpt.com/codex/install.sh"
INSTALLER_SHA256="ba92dd27e5c06f0d3bbc58bfa4b9cfb6599cd2742fbb1f92a2765e6c07dedb5a"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch/codex"
BIN_DIR="${CODEX_INSTALL_DIR:-$HOME/.local/bin}"
CODEX_BIN="$BIN_DIR/codex"

say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m OK\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m !!\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
shadowfetch-codex - Install and open the official OpenAI Codex CLI.

USAGE
  shadowfetch-codex setup [--yes] [--no-open]
  shadowfetch-codex doctor
  shadowfetch-codex open
  shadowfetch-codex status

Setup downloads the official installer over HTTPS, verifies the release-pinned
installer SHA-256, then asks OpenAI's installer to install a pinned Codex release
for this user. Signing in happens only inside Codex after installation.
EOF
}

version() {
    printf 'shadowfetch-codex (Shadowfetch Linux %s; Codex CLI %s)\n' \
        "$(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown)" "$CODEX_VERSION"
}

require_user() {
    if ((EUID == 0)); then
        warn "Codex must be installed by the desktop user, not root."
        return 1
    fi
    [[ -n "${HOME:-}" && "$HOME" != "/root" ]] || {
        warn "A writable desktop-user home directory is required."
        return 1
    }
}

codex_path() {
    if [[ -x "$CODEX_BIN" ]]; then
        printf '%s\n' "$CODEX_BIN"
    else
        command -v codex 2>/dev/null || true
    fi
}

preflight() {
    local available command
    require_user
    [[ $(uname -m) == "x86_64" ]] || {
        warn "This Shadowfetch release supports x86_64 systems only."
        return 1
    }
    for command in curl sha256sum sh flock; do
        command -v "$command" >/dev/null 2>&1 || {
            warn "$command is missing. Repair the base installation before Codex setup."
            return 1
        }
    done
    available=$(df -PB1 "$HOME" | awk 'NR == 2 {print $4}')
    [[ "$available" =~ ^[0-9]+$ ]] || {
        warn "Could not measure free disk space."
        return 1
    }
    if ((available < 1024 * 1024 * 1024)); then
        warn "Codex setup needs at least 1 GiB free."
        return 1
    fi
    printf 'Preflight passed: HTTPS tools ready and %.1f GiB free.\n' \
        "$((available / 1024 / 1024))e-3"
}

verify_installer() {
    local installer=$1
    printf '%s  %s\n' "$INSTALLER_SHA256" "$installer" | sha256sum --check --status || {
        warn "OpenAI's installer changed or failed verification. Install the latest Shadowfetch update and retry."
        return 1
    }
    [[ $(wc -c <"$installer") -ge 10000 ]] || {
        warn "The downloaded installer is unexpectedly small."
        return 1
    }
    if ! grep -Fxq '#!/bin/sh' "$installer" \
        || ! grep -Fq 'https://releases.openai.com/codex' "$installer" \
        || ! grep -Fq 'verify_archive_digest' "$installer"; then
        warn "The downloaded file does not match the expected Codex installer contract."
        return 1
    fi
    ok "Official Codex installer SHA-256 verified."
}

write_launcher() {
    local applications_dir desktop
    applications_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    desktop="$applications_dir/codex-cli.desktop"
    install -d -m 0700 "$applications_dir"
    cat >"$desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Codex CLI
Comment=Open OpenAI Codex in a terminal
Exec=/usr/bin/shadowfetch-codex open
Icon=utilities-terminal
Terminal=false
Categories=Development;Utility;
Keywords=AI;coding;agent;terminal;
StartupNotify=true
EOF
    chmod 0600 "$desktop"
    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "$applications_dir" >/dev/null 2>&1 || true
}

cmd_setup() {
    local assume_yes=0 open_after=1 answer installer tmp_dir lock_file installed
    shift || true
    while (($#)); do
        case "$1" in
            --yes|-y) assume_yes=1; shift ;;
            --no-open) open_after=0; shift ;;
            -h|--help) usage; exit 0 ;;
            *) warn "Unknown setup option: $1"; exit 2 ;;
        esac
    done

    umask 077
    install -d -m 0700 "$STATE_DIR"
    lock_file="$STATE_DIR/setup.lock"
    exec 9>"$lock_file"
    flock -n 9 || {
        warn "Another Codex setup is already running for this user."
        return 3
    }
    preflight

    echo "Shadowfetch will install official Codex CLI $CODEX_VERSION for this user."
    echo "Codex will ask you to sign in with ChatGPT after installation."
    if ((!assume_yes)); then
        read -r -p "Continue? [Y/n] " answer
        [[ ! "$answer" =~ ^[Nn]$ ]] || return 0
    fi

    tmp_dir=$(mktemp -d "$STATE_DIR/install.XXXXXX")
    installer="$tmp_dir/install.sh"
    trap 'rm -rf -- "$tmp_dir"' EXIT
    say "Downloading OpenAI's official Codex installer..."
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
        --connect-timeout 15 --max-time 120 "$INSTALLER_URL" -o "$installer"
    verify_installer "$installer"

    say "Installing digest-verified Codex CLI $CODEX_VERSION..."
    CODEX_RELEASE="$CODEX_VERSION" \
    CODEX_NON_INTERACTIVE=true \
    CODEX_INSTALLER_USE_RELEASES_OPENAI_COM=true \
    CODEX_INSTALL_DIR="$BIN_DIR" \
        sh "$installer" --release "$CODEX_VERSION"

    installed=$(codex_path)
    [[ -n "$installed" && -x "$installed" ]] || {
        warn "The official installer completed without a usable Codex command."
        return 1
    }
    "$installed" --version | grep -Fq "$CODEX_VERSION" || {
        warn "The installed Codex command did not report version $CODEX_VERSION."
        return 1
    }
    write_launcher
    "$installed" --version >"$STATE_DIR/installed-version"
    ok "Codex CLI $CODEX_VERSION is installed for this user."
    echo "No OpenAI credential was stored by Shadowfetch. Codex handles sign-in when opened."

    rm -rf -- "$tmp_dir"
    trap - EXIT
    if ((open_after)); then
        cmd_open
    fi
}

cmd_doctor() {
    local installed
    preflight
    installed=$(codex_path)
    [[ -n "$installed" && -x "$installed" ]] || {
        warn "Codex CLI is not installed for this user."
        return 1
    }
    "$installed" --version | grep -Fq "$CODEX_VERSION" || {
        warn "Codex CLI is installed, but it does not match this release pin."
        return 1
    }
    ok "Codex CLI $CODEX_VERSION passed the local installation check."
}

cmd_open() {
    local installed
    require_user
    installed=$(codex_path)
    [[ -n "$installed" && -x "$installed" ]] || {
        warn "Codex CLI is not installed. Run: shadowfetch-codex setup"
        return 1
    }
    command -v konsole >/dev/null 2>&1 || {
        warn "Konsole is missing. Open a terminal and run: $installed"
        return 1
    }
    exec konsole --workdir "$HOME" -e "$installed"
}

cmd_status() {
    local installed
    version
    installed=$(codex_path)
    if [[ -n "$installed" && -x "$installed" ]]; then
        ok "$($installed --version) is installed at $installed."
    else
        printf ' -- Codex CLI is not installed for this user.\n'
    fi
}

case "${1:-}" in
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor ;;
    open) cmd_open ;;
    status) cmd_status ;;
    --version|-V) version ;;
    -h|--help|"") usage ;;
    *) warn "Unknown command: $1"; usage; exit 2 ;;
esac
