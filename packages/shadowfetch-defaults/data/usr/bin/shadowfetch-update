#!/bin/bash
# shadowfetch-update - compatibility surface over Fireproof.
#
# THIS PROGRAM UPDATES NOTHING. It translates the old command line onto
# fireproof(1) and execs it. There is no apt, no apt-get, no dpkg, no
# snapper, no sudo and no plan hash below this line, on purpose.
#
# Until Stage U this file was a 342-line SECOND updater: its own preflight,
# its own `apt-get update`, its own `apt-get -s full-upgrade` simulation,
# its own two-entry removal allowlist, its own sha256 plan fingerprint, its
# own `apt-get full-upgrade` under sudo, and its own copy of
# snapper_max_number / snapper_first_pre_after / phoenix_available.
#
# It also relabelled the SAME snapper Point that Fireproof labels - with a
# different description, no fireproof=pre userdata - and then recorded that
# Point NOWHERE. So `shadowfetch-update` mutated the machine while
# /var/lib/shadowfetch/fireproof-state.json still described the PREVIOUS
# Fireproof transaction, and the next `fireproof rollback` would have
# restored the wrong system state. Two systems independently deciding
# snapshot behaviour is precisely how a rollback and an update come to
# disagree about what state the machine is in; that is why this file is now
# eleven lines of dispatch instead of three hundred of duplicate mechanism.
#
# The migration that used to be folded in here (the one-time 2.1.3 AI
# package retirement) is NOT lost and was never this program's to own: it
# has its own unit, shadowfetch-migrate-2.1.3-ai.service, gated on the same
# marker and the same sha256-verified manifest, which runs at
# multi-user.target. It now happens there and only there. The behavioural
# difference is real and worth stating plainly: the retirement completes at
# the next boot rather than inside the interactive update transaction.
#
# Part of Shadowfetch Linux. https://www.shadowfetchlinux.org/
set -euo pipefail

# Absolute, never resolved through PATH: this program decides which binary
# performs a root package transaction, and $PATH belongs to the caller.
FIREPROOF=/usr/bin/fireproof
VERSION_FILE=/usr/share/shadowfetch/version

version() {
    cat "$VERSION_FILE" 2>/dev/null || echo unknown
}

usage() {
    cat <<'SFHELP'
shadowfetch-update - compatibility alias for fireproof(1).

USAGE
  shadowfetch-update              same as: fireproof update
  shadowfetch-update --check      same as: fireproof check
  shadowfetch-update --verify     same as: fireproof verify
  shadowfetch-update --rollback   same as: fireproof rollback

Shadowfetch Linux has ONE update system, and `fireproof` is its command.
This name is kept so older documentation, desktop entries and habits keep
working; prefer `fireproof` in anything new.

THE FIVE STEPS, WHICH ARE NOT INTERCHANGEABLE
  simulate  resolve the pending upgrade read-only. No lock is taken,
            nothing is downloaded, nothing is installed. Produces the
            change-set hash that identifies this update.
  approve   a human accepts that exact change-set hash. Nothing changes.
  commit    take the dpkg lock, re-simulate under it, refuse if the set
            drifted, download, show release NEWS, install. snapper's own
            apt hooks create the Phoenix Point; Fireproof creates none.
  verify    judge the machine afterwards: ok, reboot-recommended, or
            restore-recommended.
  rollback  restore the Phoenix Point that commit recorded, via
            pkexec /usr/libexec/phoenix-restore. Unavailable, and said to
            be unavailable, when no Point was recorded.

`--check` performs SIMULATE only. It does not approve, commit or verify.

Part of Shadowfetch Linux. https://www.shadowfetchlinux.org/
SFHELP
}

case "${1-}" in
    -h|--help)      usage; exit 0 ;;
    --version)      echo "shadowfetch-update (Shadowfetch Linux) $(version)"; exit 0 ;;
    "")             verb=update ;;
    --check)        verb=check ;;
    --verify)       verb=verify ;;
    --rollback)     verb=rollback ;;
    *)
        printf 'shadowfetch-update: unknown option: %s\n' "$1" >&2
        printf 'Try: shadowfetch-update --help\n' >&2
        exit 2 ;;
esac

if (( $# > 1 )); then
    printf 'shadowfetch-update: too many arguments\n' >&2
    exit 2
fi

if [[ ! -x "$FIREPROOF" ]]; then
    printf 'shadowfetch-update: %s is not installed.\n' "$FIREPROOF" >&2
    printf 'Fireproof owns updates on Shadowfetch Linux; install shadowfetch-fireproof.\n' >&2
    exit 1
fi

exec "$FIREPROOF" "$verb"
