#!/usr/bin/env python3
"""Machine-readable and human-readable Shadowfetch health audit."""

import argparse
import json
import os
import shutil
import socket
import subprocess
from dataclasses import asdict, dataclass
from pathlib import Path


@dataclass
class Check:
    name: str
    status: str
    summary: str
    action: str = ""


def run(command, timeout=8):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as error:
        return 127, "", str(error)


def command_check(name, binary, optional=True):
    path = shutil.which(binary)
    if path:
        return Check(name, "pass", f"Available at {path}")
    return Check(name, "info" if optional else "warn", "Not installed", f"Run the matching Shadowfetch setup tool for {binary}.")


def collect(quick=False):
    checks = []
    disk = shutil.disk_usage("/")
    disk_used = round(disk.used / disk.total * 100)
    disk_free_gib = disk.free / 1024**3
    checks.append(Check("System disk", "warn" if disk_used >= 90 else "pass", f"{disk_used}% used · {disk_free_gib:.1f} GiB free", "Free at least 10 GiB before a large update." if disk_used >= 90 else ""))

    memory = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        key, value = line.split(":", 1)
        memory[key] = int(value.strip().split()[0])
    available_gib = memory.get("MemAvailable", 0) / 1024**2
    checks.append(Check("Memory", "warn" if available_gib < 1 else "pass", f"{available_gib:.1f} GiB available"))

    load = os.getloadavg()[0]
    cpu = os.cpu_count() or 1
    checks.append(Check("CPU load", "warn" if load > cpu * 1.5 else "pass", f"1-minute load {load:.2f} across {cpu} threads"))

    _, failed, _ = run(["systemctl", "--failed", "--no-legend", "--plain"])
    failed_count = len([line for line in failed.splitlines() if line.strip()])
    checks.append(Check("System services", "warn" if failed_count else "pass", f"{failed_count} failed unit(s)", "Run systemctl --failed for details." if failed_count else ""))

    code, audit, _ = run(["dpkg", "--audit"], 15)
    packages_ok = code == 0 and not audit
    checks.append(Check("Package database", "pass" if packages_ok else "warn", "Consistent" if packages_ok else "Needs repair", "" if packages_ok else "Run sudo dpkg --configure -a, then shadowfetch-update."))

    if not quick:
        code, output, error = run(["curl", "-fsSIL", "--max-time", "8", "https://www.shadowfetch.com/linux/apt/dists/umbra/InRelease"], 12)
        checks.append(Check("Update channel", "pass" if code == 0 else "warn", "Reachable and signed metadata is available" if code == 0 else (error or "Unreachable"), "Check the network and system clock." if code else ""))

    checks.append(command_check("Container sandbox", "podman"))
    return checks


def main():
    parser = argparse.ArgumentParser(description="Check Shadowfetch system health")
    parser.add_argument("--json", action="store_true", help="emit structured JSON")
    # Same file every other tool reports from, so a bug report cannot cite a
    # version the system itself disagrees with.
    _vf = "/usr/share/shadowfetch/version"
    _v = open(_vf).read().strip() if os.path.exists(_vf) else "unknown"
    parser.add_argument("--version", action="version",
                        version=f"shadowfetch-health (Shadowfetch Linux) {_v}")
    parser.add_argument("--quick", action="store_true", help="skip network checks")
    args = parser.parse_args()
    checks = collect(args.quick)
    counts = {status: sum(item.status == status for item in checks) for status in ("pass", "warn", "fail", "info")}
    if args.json:
        print(json.dumps({"version": 1, "hostname": socket.gethostname(), "summary": counts, "checks": [asdict(item) for item in checks]}, indent=2))
    else:
        print("Shadowfetch System Health")
        print("=" * 64)
        glyph = {"pass": "OK", "warn": "!!", "fail": "XX", "info": "--"}
        for item in checks:
            print(f"[{glyph[item.status]}] {item.name}: {item.summary}")
            if item.action:
                print(f"     Next: {item.action}")
        print("=" * 64)
        print(f"{counts['pass']} healthy · {counts['warn']} warnings · {counts['fail']} failures · {counts['info']} optional")
    return 2 if counts["fail"] else (1 if counts["warn"] else 0)


if __name__ == "__main__":
    raise SystemExit(main())
