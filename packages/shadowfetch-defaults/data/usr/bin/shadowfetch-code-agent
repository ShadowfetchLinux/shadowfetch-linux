#!/bin/bash
# Verified, user-owned installers and launchers for optional coding agents.
set -euo pipefail

STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/shadowfetch/code-agents"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
BIN_DIR="${SHADOWFETCH_CODE_AGENT_BIN_DIR:-$HOME/.local/bin}"

say() { printf '\033[1;33m==>\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m OK\033[0m %s\n' "$*"; }
warn() { printf '\033[1;31m !!\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'EOF'
shadowfetch-code-agent - Install and open optional coding agents.

USAGE
  shadowfetch-code-agent <claude|grok|cursor> setup [--yes] [--no-open]
  shadowfetch-code-agent <claude|grok|cursor> doctor
  shadowfetch-code-agent <claude|grok|cursor> open
  shadowfetch-code-agent <claude|grok|cursor> status
  shadowfetch-code-agent --version

Setup downloads a release-pinned Linux artifact from the vendor's official
HTTPS endpoint, verifies its SHA-256 before installation, and installs it only
for the current desktop user. Shadowfetch does not collect or copy credentials;
each tool handles its own sign-in after first launch.
EOF
}

version() {
    printf '%s\n' \
        "shadowfetch-code-agent (Shadowfetch Linux $(cat /usr/share/shadowfetch/version 2>/dev/null || echo unknown))" \
        'Claude Code 2.1.227; Grok Build 1.0.5; Cursor Agent 2026.08.11-e8db854'
}

configure_tool() {
    case "$TOOL" in
        claude)
            NAME="Claude Code"
            VERSION="2.1.227"
            ARTIFACT_URL="https://downloads.claude.ai/claude-code-releases/2.1.227/linux-x64/claude"
            ARTIFACT_SHA256="6832dc3f1797b890b71116e5f2dbbf9a83fd3d0498c235b4b0f9cd0e6e499ad6"
            BINARY_SHA256="$ARTIFACT_SHA256"
            ARTIFACT_KIND="binary"
            TARGET_DIR="$DATA_HOME/claude/versions/$VERSION"
            TARGET_BIN="$TARGET_DIR/claude"
            LINK_BIN="$BIN_DIR/claude"
            DESKTOP_FILE="claude-code.desktop"
            DESKTOP_COMMENT="Open Anthropic Claude Code in a terminal"
            ;;
        grok)
            NAME="Grok Build"
            VERSION="1.0.5"
            ARTIFACT_URL="https://x.ai/cli/grok-1.0.5-linux-x86_64"
            ARTIFACT_SHA256="9ba87444e1819e8f6104adbbf4676a870c204380aa5c3e1c38a926c4ea677238"
            BINARY_SHA256="$ARTIFACT_SHA256"
            ARTIFACT_KIND="binary"
            TARGET_DIR="$DATA_HOME/grok/versions/$VERSION"
            TARGET_BIN="$TARGET_DIR/grok"
            LINK_BIN="$BIN_DIR/grok"
            DESKTOP_FILE="grok-build.desktop"
            DESKTOP_COMMENT="Open xAI Grok Build in a terminal"
            ;;
        cursor)
            NAME="Cursor Agent"
            VERSION="2026.08.11-e8db854"
            ARTIFACT_URL="https://downloads.cursor.com/lab/2026.08.11-e8db854/linux/x64/agent-cli-package.tar.gz"
            ARTIFACT_SHA256="bfff4bf6f4e9dd30c1d0ef0a70b6077b074015dd2948e4c50685d53afdcfce5a"
            BINARY_SHA256="eed61c5224668c9236334c4c68936a16aecc37374b592f59e31eb50433817831"
            ARTIFACT_KIND="archive"
            TARGET_DIR="$DATA_HOME/cursor-agent/versions/$VERSION"
            TARGET_BIN="$TARGET_DIR/cursor-agent"
            LINK_BIN="$BIN_DIR/cursor-agent"
            DESKTOP_FILE="cursor-agent.desktop"
            DESKTOP_COMMENT="Open Cursor Agent in a terminal"
            ;;
        *)
            warn "Unknown coding agent: ${TOOL:-<none>}"
            usage
            return 2
            ;;
    esac
    TOOL_STATE="$STATE_ROOT/$TOOL"
}

require_user() {
    if ((EUID == 0)); then
        warn "$NAME must be installed by the desktop user, not root."
        return 1
    fi
    [[ -n "${HOME:-}" && "$HOME" != "/root" ]] || {
        warn "A writable desktop-user home directory is required."
        return 1
    }
}

require_platform() {
    require_user
    [[ $(uname -s) == "Linux" && $(uname -m) == "x86_64" ]] || {
        warn "This Shadowfetch release supports x86_64 Linux systems only."
        return 1
    }
}

preflight() {
    local available command
    require_platform
    for command in curl sha256sum flock df awk install mktemp; do
        command -v "$command" >/dev/null 2>&1 || {
            warn "$command is missing. Repair the base installation before setup."
            return 1
        }
    done
    if [[ "$ARTIFACT_KIND" == "archive" ]]; then
        command -v tar >/dev/null 2>&1 || {
            warn "tar is missing. Repair the base installation before setup."
            return 1
        }
    fi
    available=$(df -PB1 "$HOME" | awk 'NR == 2 {print $4}')
    [[ "$available" =~ ^[0-9]+$ ]] || {
        warn "Could not measure free disk space."
        return 1
    }
    if ((available < 1024 * 1024 * 1024)); then
        warn "$NAME setup needs at least 1 GiB free."
        return 1
    fi
    printf 'Preflight passed: x86_64 Linux, HTTPS tools ready, %.1f GiB free.\n' \
        "$((available / 1024 / 1024))e-3"
}

download_artifact() {
    local destination=$1
    curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
        --retry 3 --connect-timeout 15 --max-time 900 \
        "$ARTIFACT_URL" -o "$destination"
}

verify_digest() {
    local expected=$1 file=$2 label=$3
    printf '%s  %s\n' "$expected" "$file" | sha256sum --check --status || {
        warn "$label changed or failed SHA-256 verification. Install the latest Shadowfetch update and retry."
        return 1
    }
    ok "$label SHA-256 verified."
}

version_matches() {
    local output
    [[ -x "$TARGET_BIN" ]] || return 1
    output=$("$TARGET_BIN" --version 2>/dev/null) || return 1
    case "$TOOL" in
        claude) [[ "$output" == "$VERSION (Claude Code)" ]] ;;
        grok) [[ "$output" == "grok $VERSION "* ]] ;;
        cursor) [[ "$output" == "$VERSION" ]] ;;
    esac
}

installed_artifact_matches() {
    [[ -x "$TARGET_BIN" ]] || return 1
    printf '%s  %s\n' "$BINARY_SHA256" "$TARGET_BIN" \
        | sha256sum --check --status || return 1
    version_matches
}

install_binary_artifact() {
    local artifact=$1 staged
    install -d -m 0700 "$TARGET_DIR"
    staged="$TARGET_BIN.new.$$"
    install -m 0700 "$artifact" "$staged"
    mv -f -- "$staged" "$TARGET_BIN"
}

install_archive_artifact() {
    local artifact=$1 parent staged backup=""
    parent=$(dirname "$TARGET_DIR")
    install -d -m 0700 "$parent"
    staged=$(mktemp -d "$parent/.${TOOL}-${VERSION}.XXXXXX")
    tar -xzf "$artifact" --strip-components=1 -C "$staged"
    [[ -x "$staged/cursor-agent" ]] || chmod 0700 "$staged/cursor-agent"
    verify_digest "$BINARY_SHA256" "$staged/cursor-agent" "Cursor executable"
    if [[ -e "$TARGET_DIR" ]]; then
        backup="$parent/.${TOOL}-${VERSION}.previous.$$"
        mv -- "$TARGET_DIR" "$backup"
    fi
    if mv -- "$staged" "$TARGET_DIR"; then
        [[ -z "$backup" ]] || rm -rf -- "$backup"
    else
        [[ -z "$backup" || -e "$TARGET_DIR" ]] || mv -- "$backup" "$TARGET_DIR"
        rm -rf -- "$staged"
        return 1
    fi
}

write_binary_link() {
    install -d -m 0700 "$BIN_DIR"
    if [[ -e "$LINK_BIN" && ! -L "$LINK_BIN" ]]; then
        warn "Refusing to replace the existing non-symlink at $LINK_BIN."
        return 1
    fi
    ln -sfn -- "$TARGET_BIN" "$LINK_BIN"
}

write_launcher() {
    local applications_dir desktop
    applications_dir="$DATA_HOME/applications"
    desktop="$applications_dir/$DESKTOP_FILE"
    install -d -m 0700 "$applications_dir"
    cat >"$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$NAME
Comment=$DESKTOP_COMMENT
Exec=/usr/bin/shadowfetch-code-agent $TOOL open
Icon=utilities-terminal
Terminal=false
Categories=Development;Utility;
Keywords=AI;coding;agent;terminal;
StartupNotify=true
EOF
    chmod 0600 "$desktop"
    command -v update-desktop-database >/dev/null 2>&1 \
        && update-desktop-database "$applications_dir" >/dev/null 2>&1 || true
}

write_receipt() {
    install -d -m 0700 "$TOOL_STATE"
    cat >"$TOOL_STATE/installed-release" <<EOF
tool=$TOOL
name=$NAME
version=$VERSION
artifact_sha256=$ARTIFACT_SHA256
binary_sha256=$BINARY_SHA256
binary=$TARGET_BIN
installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
credentials_stored_by_shadowfetch=false
EOF
    chmod 0600 "$TOOL_STATE/installed-release"
}

cmd_setup() {
    local assume_yes=0 open_after=1 answer artifact lock_file tmp_dir
    shift 2 || true
    while (($#)); do
        case "$1" in
            --yes|-y) assume_yes=1; shift ;;
            --no-open) open_after=0; shift ;;
            -h|--help) usage; return 0 ;;
            *) warn "Unknown setup option: $1"; return 2 ;;
        esac
    done

    umask 077
    install -d -m 0700 "$TOOL_STATE"
    lock_file="$TOOL_STATE/setup.lock"
    exec 9>"$lock_file"
    flock -n 9 || {
        warn "Another $NAME setup is already running for this user."
        return 3
    }
    preflight

    echo "Shadowfetch will install official $NAME $VERSION for this user."
    echo "$NAME will handle its own account sign-in after installation."
    if ((!assume_yes)); then
        read -r -p "Continue? [Y/n] " answer
        [[ ! "$answer" =~ ^[Nn]$ ]] || return 0
    fi

    if installed_artifact_matches; then
        write_binary_link
        write_launcher
        write_receipt
        ok "$NAME $VERSION is already installed and verified."
    else
        tmp_dir=$(mktemp -d "$TOOL_STATE/install.XXXXXX")
        artifact="$tmp_dir/artifact"
        trap 'rm -rf -- "$tmp_dir"' EXIT
        say "Downloading $NAME $VERSION from its official release endpoint..."
        download_artifact "$artifact"
        verify_digest "$ARTIFACT_SHA256" "$artifact" "$NAME release artifact"
        say "Installing verified $NAME $VERSION for this user..."
        if [[ "$ARTIFACT_KIND" == "archive" ]]; then
            install_archive_artifact "$artifact"
        else
            install_binary_artifact "$artifact"
        fi
        installed_artifact_matches || {
            warn "$NAME did not pass its installed binary and version checks."
            return 1
        }
        write_binary_link
        write_launcher
        write_receipt
        rm -rf -- "$tmp_dir"
        trap - EXIT
        ok "$NAME $VERSION is installed and verified for this user."
    fi
    echo "No $NAME credential was stored by Shadowfetch. Sign-in begins only when you open it."

    if ((open_after)); then
        cmd_open
    fi
}

cmd_doctor() {
    require_platform
    installed_artifact_matches || {
        warn "$NAME is missing, changed, or does not match this release pin."
        return 1
    }
    [[ -L "$LINK_BIN" && $(readlink -f "$LINK_BIN") == "$(readlink -f "$TARGET_BIN")" ]] || {
        warn "$NAME is verified, but its user command link needs repair. Run setup again."
        return 1
    }
    ok "$NAME $VERSION passed the local artifact, version, and launcher checks."
}

cmd_open() {
    require_user
    installed_artifact_matches || {
        warn "$NAME is not installed. Run: shadowfetch-code-agent $TOOL setup"
        return 1
    }
    command -v konsole >/dev/null 2>&1 || {
        warn "Konsole is missing. Open a terminal and run: $LINK_BIN"
        return 1
    }
    exec konsole --workdir "$HOME" -e "$TARGET_BIN"
}

cmd_status() {
    if installed_artifact_matches; then
        ok "$NAME $VERSION is installed and verified at $TARGET_BIN."
    else
        printf ' -- %s is not installed at this Shadowfetch release pin.\n' "$NAME"
    fi
}

case "${1:-}" in
    --version|-V) version; exit 0 ;;
    -h|--help|"") usage; exit 0 ;;
esac

TOOL=${1:-}
ACTION=${2:-}
configure_tool
case "$ACTION" in
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor ;;
    open) cmd_open ;;
    status) cmd_status ;;
    -h|--help|"") usage ;;
    *) warn "Unknown command: ${ACTION:-<none>}"; usage; exit 2 ;;
esac
