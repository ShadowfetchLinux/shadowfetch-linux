#!/bin/bash
# Privileged, fixed-input installer for the official Buzz Desktop package.
set -euo pipefail

BUZZ_VERSION="0.5.17"
BUZZ_DEB_URL="https://github.com/block/buzz/releases/download/desktop-v${BUZZ_VERSION}/Buzz_${BUZZ_VERSION}_amd64.deb"
BUZZ_DEB_SHA256="cf28de6ba023fdb6eb676f183579e1df4d83bc29b4ebfa6c26ad8e3f327e0fef"

usage() {
    cat <<'EOF'
shadowfetch-buzz-provision - verified Buzz Desktop installer (internal helper)

USAGE
  shadowfetch-buzz-provision

The official amd64 package is version-pinned and SHA-256 verified before apt
sees it. The transaction is simulated first and package removals are refused.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) echo "Unsupported argument: $1" >&2; usage >&2; exit 2 ;;
esac

if (( EUID != 0 )); then
    echo "This internal helper must run as root through pkexec or sudo." >&2
    exit 1
fi
if [[ $(uname -m) != "x86_64" ]]; then
    echo "Shadowfetch Fire Edition 3.0.0 supports x86_64 systems only." >&2
    exit 3
fi
for command in apt-get curl dpkg dpkg-query flock sha256sum; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "$command is required to install Buzz." >&2
        exit 4
    }
done

install -d -m 0755 /var/log/shadowfetch /run/lock
log="/var/log/shadowfetch/buzz-provision-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$log") 2>&1
exec 9>/run/lock/shadowfetch-buzz-provision.lock
flock -n 9 || { echo "Another Buzz installation is already running." >&2; exit 5; }

tmpdir=$(mktemp -d /var/tmp/shadowfetch-buzz-provision.XXXXXX)
cleanup() {
    cleanup_status=$?
    rm -rf -- "$tmpdir"
    trap - EXIT
    exit "$cleanup_status"
}
trap cleanup EXIT

if dpkg --audit | grep -q .; then
    echo "The package database needs repair before Buzz can be installed." >&2
    echo "Run: sudo dpkg --configure -a" >&2
    exit 6
fi

available=$(df -PB1 /var/tmp | awk 'NR == 2 {print $4}')
required=$((2 * 1024 * 1024 * 1024))
if [[ ! "$available" =~ ^[0-9]+$ ]] || (( available < required )); then
    echo "Buzz installation needs at least 2 GiB free in /var/tmp." >&2
    exit 7
fi

installed=$(dpkg-query -W -f='${Version}' buzz 2>/dev/null || true)
if [[ -n "$installed" ]] && dpkg --compare-versions "$installed" ge "$BUZZ_VERSION"; then
    echo "Keeping installed Buzz Desktop $installed (required: $BUZZ_VERSION or newer)."
    echo "Buzz package check complete. Diagnostic log: $log"
    exit 0
fi

deb="$tmpdir/buzz.deb"
echo "Downloading official Buzz Desktop ${BUZZ_VERSION}..."
curl --fail --show-error --location \
    --proto '=https' --tlsv1.2 \
    --retry 5 --retry-all-errors --retry-delay 2 \
    --connect-timeout 15 --speed-time 60 --speed-limit 1024 \
    "$BUZZ_DEB_URL" -o "$deb"
printf '%s  %s\n' "$BUZZ_DEB_SHA256" "$deb" | sha256sum --check --status || {
    echo "Buzz Desktop failed SHA-256 verification; nothing was installed." >&2
    exit 8
}
echo "Buzz Desktop checksum verified."

simulation="$tmpdir/apt-simulation.txt"
DEBIAN_FRONTEND=noninteractive apt-get \
    -o DPkg::Lock::Timeout=120 -s install "$deb" >"$simulation"
if grep -q '^Remv ' "$simulation"; then
    echo "Buzz installation would remove packages, so Shadowfetch refused it." >&2
    cat "$simulation" >&2
    exit 9
fi

echo "Installing Buzz Desktop..."
DEBIAN_FRONTEND=noninteractive apt-get \
    -o DPkg::Lock::Timeout=120 --no-remove install -y "$deb"
installed=$(dpkg-query -W -f='${Version}' buzz 2>/dev/null || true)
if [[ -z "$installed" ]] || ! dpkg --compare-versions "$installed" ge "$BUZZ_VERSION"; then
    echo "Buzz package verification failed after installation." >&2
    exit 10
fi

echo "Buzz Desktop $installed is installed. Diagnostic log: $log"
